<view class="flow-page browse-page">
  <view class="flow-header">
    <text class="flow-step">{{labels.step}}</text>
    <text class="flow-title">{{labels.title}}</text>
    <text class="flow-sub">{{serviceModeName}} | {{serviceTypeName}}</text>
  </view>

  <view class="section-card">
    <text class="section-title">{{labels.currentFilter}}</text>
    <text class="sub-text">{{labels.serviceType}}: {{serviceTypeName || "-"}}</text>
    <text class="sub-text">{{labels.address}}: {{addressText || "-"}}</text>
  </view>

  <view class="section-card">
    <view wx:if="{{technicians.length}}" class="tech-list">
      <view
        wx:for="{{technicians}}"
        wx:key="id"
        class="tech-card {{selectedTechnicianId === item.id ? 'tech-card-active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="onSelectTechnician"
      >
        <view class="tech-top">
          <view class="tech-avatar">
            <image wx:if="{{item.avatarUrl}}" class="avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar-fallback">{{item.name ? item.name.substring(0, 1) : labels.defaultInitial}}</view>
          </view>
          <view class="tech-main">
            <view class="tech-name-row">
              <text wx:if="{{selectedTechnicianId === item.id}}" class="mini-badge badge-selected">{{labels.selectedTag}}</text>
              <text class="tech-name">{{item.name}}</text>
              <text wx:if="{{item.isRecommend}}" class="mini-badge badge-recommend">{{labels.recommendTag}}</text>
            </view>
            <view class="tech-meta">
              <text class="tech-meta-item">{{labels.rating}} {{item.rating}}</text>
              <text class="tech-meta-item">{{labels.orderCount}} {{item.orderCount}}</text>
              <text class="tech-meta-item">{{labels.distance}} {{item.distanceText}} km</text>
            </view>
            <text class="status-pill status-{{item.workStatusType}}">{{item.workStatusText}}</text>
          </view>
          <view class="icon-actions">
            <view class="icon-btn {{item.isFollowed ? 'icon-btn-active' : ''}}" data-id="{{item.id}}" catchtap="onToggleFollow">
              <text class="icon-symbol">{{item.isFollowed ? labels.followedIcon : labels.followIcon}}</text>
            </view>
            <view class="icon-btn" data-id="{{item.id}}" catchtap="onViewProfile">
              <text class="icon-symbol">{{labels.profileIcon}}</text>
            </view>
          </view>
        </view>
        <text class="tap-hint">{{selectedTechnicianId === item.id ? labels.selectedHint : labels.tapToSelect}}</text>
      </view>
    </view>
    <view wx:else class="empty-tip">{{labels.empty}}</view>
  </view>
</view>

<view class="browse-footer">
  <button class="footer-btn footer-btn-ghost" bindtap="onBack">{{labels.back}}</button>
  <button class="footer-btn footer-btn-primary" bindtap="onConfirmChoose">{{labels.confirm}}</button>
</view>

