---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="联系我们"
  description="联系速修派客服，预约电器维修服务。微信小程序搜索「速修派」或拨打客服热线。"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>联系我们</h1>
      <p>随时为您服务，预约维修或咨询答疑</p>
    </div>
  </section>

  <!-- QR / Platform Section -->
  <section class="section" style="background:var(--color-bg-alt);text-align:center;">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">扫码直达</span>
        <h2 class="section-title">更多方式找到我们</h2>
        <p class="section-subtitle">扫码或搜索，随时随地预约维修</p>
      </div>

      <div class="qr-row reveal-stagger">
        <!--
          📌 二维码占位区
          用途：微信小程序码
          建议尺寸：300×300px · PNG（透明底或白底）
          可包含小程序名称文字
        -->
        <div class="qr-card">
          <div class="qr-placeholder">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity=".35"
              ><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"
              ></rect><rect x="3" y="14" width="7" height="7"></rect><rect
                x="14"
                y="14"
                width="7"
                height="7"></rect></svg
            >
          </div>
          <p>微信小程序</p>
          <span>搜索「速修派」</span>
        </div>

        <!--
          📌 二维码占位区
          用途：微信公众号二维码
          建议尺寸：300×300px · PNG
        -->
        <div class="qr-card">
          <div class="qr-placeholder">
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity=".35"
              ><path
                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
              ></path></svg
            >
          </div>
          <p>微信公众号</p>
          <span>搜索「速修派」</span>
        </div>

        <div class="qr-card">
          <div
            class="qr-placeholder"
            style="background:var(--gradient-brand);color:#fff;border:none;"
          >
            <svg
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              opacity=".8"
              ><path
                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
              ></path></svg
            >
          </div>
          <p>客服电话</p>
          <span>18647814174</span>
          <span class="qr-size-hint">服务时间 8:00-20:00</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== QR Cards ===== */
  .qr-row {
    display: flex;
    justify-content: center;
    gap: 56px;
    flex-wrap: wrap;
  }

  .qr-card {
    text-align: center;
    max-width: 200px;
  }

  .qr-placeholder {
    width: 140px;
    height: 140px;
    background: #fff;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    color: var(--color-text-muted);
    transition: border-color 0.3s;
  }
  .qr-card:hover .qr-placeholder {
    border-color: var(--color-primary);
  }

  .qr-card p {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .qr-card span {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
  }
  .qr-size-hint {
    display: block;
    font-size: 0.72rem !important;
    color: var(--color-text-muted) !important;
    margin-top: 6px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .qr-row {
      gap: 36px;
    }
  }
</style>
