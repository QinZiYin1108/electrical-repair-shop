<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.UserAccountsMapper">

    <resultMap id="BaseResultMap" type="com.example.backend.entity.UserAccounts">
            <id property="id" column="id" />
            <result property="wxOpenid" column="wx_openid" />
            <result property="wxUnionid" column="wx_unionid" />
            <result property="username" column="username" />
            <result property="phone" column="phone" />
            <result property="email" column="email" />
            <result property="password" column="password" />
            <result property="salt" column="salt" />
            <result property="isVerified" column="is_verified" />
            <result property="balance" column="balance" />
            <result property="status" column="status" />
            <result property="cancelApplyTime" column="cancel_apply_time" />
            <result property="cancelTime" column="cancel_time" />
            <result property="createdTime" column="created_time" />
            <result property="updatedTime" column="updated_time" />
            <result property="version" column="version" />
            <result property="isDelete" column="is_delete" />
    </resultMap>

    <sql id="Base_Column_List">
        id,wx_openid,wx_unionid,username,phone,
        email,password,salt,is_verified,balance,status,
        cancel_apply_time,cancel_time,created_time,updated_time,version,
        is_delete
    </sql>

    <select id="selectByEmailIncludeDeleted" resultMap="BaseResultMap">
        SELECT
            id,
            wx_openid,
            wx_unionid,
            username,
            phone,
            email,
            password,
            salt,
            is_verified,
            balance,
            status,
            cancel_apply_time,
            cancel_time,
            created_time,
            updated_time,
            version,
            is_delete
        FROM user_accounts
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="selectByWxOpenidIncludeDeleted" resultMap="BaseResultMap">
        SELECT
            id,
            wx_openid,
            wx_unionid,
            username,
            phone,
            email,
            password,
            salt,
            is_verified,
            balance,
            status,
            cancel_apply_time,
            cancel_time,
            created_time,
            updated_time,
            version,
            is_delete
        FROM user_accounts
        WHERE wx_openid = #{wxOpenid}
        LIMIT 1
    </select>
</mapper>
