.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #f5f6f8;
}

.flow-summary {
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1f7fb 100%);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.04);
}

.flow-summary-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #20242a;
}

.flow-summary-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.flow-card {
  margin-top: 20rpx;
  padding: 20rpx 0 24rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.05);
}

.load-more {
  display: flex;
  justify-content: center;
  margin-top: 18rpx;
}

