.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
}

.top-area {
  height: 40vh;
  padding: 80rpx 40rpx 0;
  box-sizing: border-box;
  background-image: linear-gradient(135deg, #409eff, #7ec8ff);
  position: relative;
  color: #ffffff;
}

.time-text {
  font-size: 72rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.3);
}

.welcome-text {
  margin-top: 28rpx;
  font-size: 48rpx;
  font-weight: 500;
  color: #ffffff;
}

.top-wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -24rpx;
  height: 48rpx;
  background-color: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}

.middle-area {
  margin-top: 16rpx;
  padding: 40rpx 40rpx 24rpx;
  box-sizing: border-box;
}

.login-card {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(36, 78, 137, 0.08);
}

.login-mode-switch {
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 999rpx;
  background-color: #f2f7ff;
}

.login-mode-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #6b7280;
}

.login-mode-item-active {
  background-color: #ffffff;
  color: #2f6bff;
  box-shadow: 0 8rpx 18rpx rgba(47, 107, 255, 0.12);
}

.login-fields {
  margin-top: 24rpx;
}

.login-field-shell {
  overflow: hidden;
  border-radius: 20rpx;
  border: 2rpx solid #e5edf8;
  background-color: #fbfdff;
}

.login-field-shell + .login-field-shell {
  margin-top: 16rpx;
}

.login-mode-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8a94a6;
}

.primary-login-btn {
  width: 100% !important;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0;
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.primary-login-btn::after {
  border: none;
}

.primary-login-btn-wechat {
  background-color: #07c160;
  box-shadow: 0 4rpx 8rpx rgba(7, 193, 96, 0.2);
}

.primary-login-btn-password {
  background-color: #2f6bff;
  box-shadow: 0 4rpx 8rpx rgba(47, 107, 255, 0.2);
}

.primary-login-btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

.btn-hover {
  opacity: 0.92;
  transform: scale(0.98);
}

.btn-content {
  display: flex;
  align-items: center;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.agreement-row {
  display: flex;
  align-items: flex-start;
  width: 100%;
  margin-top: 32rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #dcdfe6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.checkbox-checked {
  background-color: #409eff;
  border-color: #409eff;
  color: #ffffff;
}

.agreement-text-container {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  line-height: 1.8;
  flex: 1;
}

.agreement-text {
  font-size: 20rpx;
  color: #666666;
}

.agreement-link {
  font-size: 20rpx;
  color: #409eff;
  margin: 0 4rpx;
}
