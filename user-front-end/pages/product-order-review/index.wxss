.review-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f7fb 0%, #eef4fb 100%);
}

.state-card,
.hero-card,
.section-card {
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.06);
}

.state-card {
  padding: 32rpx 28rpx;
  text-align: center;
}

.state-text,
.state-desc,
.field-tip,
.switch-tip,
.empty-text,
.review-meta,
.reply-time,
.goods-meta {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-title,
.section-title,
.hero-title,
.field-title,
.reply-title,
.switch-title,
.goods-name {
  color: #0f172a;
  font-weight: 600;
}

.state-title,
.section-title {
  font-size: 30rpx;
}

.primary-btn,
.hero-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.retry-btn {
  min-width: 200rpx;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
}

.hero-card {
  padding: 28rpx;
  background: linear-gradient(135deg, #1677ff 0%, #155eef 100%);
  color: #ffffff;
}

.hero-head,
.section-head,
.info-row,
.switch-row,
.review-meta,
.goods-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-head {
  align-items: center;
}

.hero-title {
  font-size: 34rpx;
  color: #ffffff;
}

.hero-order,
.hero-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
  word-break: break-all;
}

.hero-service {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.hero-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.section-head {
  align-items: center;
}

.status-badge {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background-color: #eff6ff;
  color: #155eef;
  font-size: 22rpx;
  font-weight: 600;
}

.goods-item + .goods-item,
.info-row + .info-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2f7;
}

.goods-media {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  overflow: hidden;
  background: #eff6ff;
}

.goods-image,
.goods-image-empty {
  width: 100%;
  height: 100%;
}

.goods-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.goods-main {
  flex: 1;
  min-width: 0;
}

.goods-name {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
}

.goods-meta {
  display: block;
  margin-top: 8rpx;
}

.goods-total {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #ef4444;
}

.info-label {
  flex-shrink: 0;
  width: 168rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: right;
  word-break: break-all;
}

.field-title {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.field-title:first-of-type {
  margin-top: 0;
}

.stars-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.star-icon {
  color: #cbd5e1;
  font-size: 46rpx;
  line-height: 1;
}

.star-active {
  color: #f59e0b;
}

.content-textarea {
  width: 100%;
  min-height: 220rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #dbe4ef;
  background-color: #f8fafc;
  box-sizing: border-box;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.upload-image-wrap,
.upload-trigger,
.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
}

.upload-image-wrap {
  position: relative;
}

.image-item {
  background-color: #e2e8f0;
}

.delete-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  min-width: 64rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background-color: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.upload-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  background-color: #f8fafc;
  box-sizing: border-box;
}

.upload-trigger-plus {
  color: #0f766e;
  font-size: 44rpx;
  line-height: 1;
}

.upload-trigger-text {
  margin-top: 12rpx;
  color: #475569;
  font-size: 22rpx;
}

.switch-row {
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 0 4rpx;
  border-top: 2rpx solid #eef2f7;
}

.switch-title {
  font-size: 26rpx;
}

.switch-pill {
  position: relative;
  width: 94rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background-color: #dbe4ef;
  transition: all 0.2s ease;
}

.switch-pill-active {
  background-color: #14b8a6;
}

.switch-dot {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background-color: #ffffff;
  transition: all 0.2s ease;
}

.switch-dot-active {
  left: 48rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 28rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.review-content,
.reply-content {
  margin-top: 18rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.review-meta {
  margin-top: 14rpx;
}

.reply-card {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
}

.reply-title {
  font-size: 24rpx;
}

.empty-card {
  text-align: center;
}
