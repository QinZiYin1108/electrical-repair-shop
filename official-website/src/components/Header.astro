---
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/services', label: '服务项目' },
  { href: '/about', label: '关于我们' },
  { href: '/contact', label: '联系我们' },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <img src="/images/logo.png" alt="安修到家" class="brand-logo" width="40" height="40" />
      <span class="brand-name">安修<span>到家</span></span>
    </a>

    <button class="mobile-toggle" aria-label="菜单">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={[{ active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
      <a href="/contact" class="btn btn-primary" style="padding:10px 24px;font-size:.9rem;">
        立即预约
      </a>
    </nav>
  </div>
</header>
