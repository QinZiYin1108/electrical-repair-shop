<view class="protocol-page">
  <view class="protocol-card">
    <view class="protocol-title">{{title}}</view>
    <view wx:if="{{fileName}}" class="protocol-meta">文件：{{fileName}}</view>
    <view wx:if="{{updatedTimeText}}" class="protocol-meta">最近更新：{{updatedTimeText}}</view>

    <view wx:if="{{loading}}" class="protocol-placeholder">加载中...</view>
    <rich-text wx:else class="protocol-rich-text" nodes="{{htmlContent}}"></rich-text>
  </view>
</view>
