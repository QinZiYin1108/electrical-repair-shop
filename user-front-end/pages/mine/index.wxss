.page {
  min-height: 100vh;
  padding: 0 24rpx 180rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(70, 155, 255, 0.16), transparent 34%),
    linear-gradient(180deg, #eef6ff 0%, #f6f8fc 32%, #f5f6f8 100%);
}

.hero-section {
  position: relative;
  margin: 0 -24rpx;
  padding: 28rpx 24rpx 0;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 26rpx;
  left: 18rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-decoration-right {
  top: 94rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.16);
}

.profile-card,
.section-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.profile-card {
  padding: 28rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
  overflow: hidden;
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar-shell {
  width: 112rpx;
  height: 112rpx;
  margin-right: 22rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.16);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1677ff;
  font-size: 30rpx;
  font-weight: 600;
}

.avatar-placeholder {
  color: #1677ff;
}

.user-base {
  flex: 1;
  min-width: 0;
}

.user-top-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-name {
  max-width: 360rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 20rpx;
  line-height: 1;
}

.user-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.profile-arrow {
  margin-left: 18rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.78);
}

.completion-card,
.guest-copy {
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(10rpx);
}

.completion-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.completion-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.completion-value {
  font-size: 24rpx;
  font-weight: 700;
}

.completion-track {
  height: 10rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  overflow: hidden;
}

.completion-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #fff4bf 0%, #ffffff 100%);
}

.guest-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.guest-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.hero-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.hero-action-card {
  width: 48.5%;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-action-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.guest-action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}

.guest-action-row .van-button {
  flex: 1;
}

.section-card {
  margin-top: 22rpx;
  padding: 24rpx;
  background: #ffffff;
}

.stats-card {
  margin-top: 20rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-link {
  font-size: 22rpx;
  color: #64748b;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.stat-item {
  position: relative;
  width: 23%;
  padding: 24rpx 0 18rpx;
  border-radius: 22rpx;
  text-align: center;
  background: linear-gradient(180deg, #f8fbff 0%, #f6f8fc 100%);
}

.stat-pill {
  width: 34rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 999rpx;
}

.stat-pill-amber {
  background: #ffb54d;
}

.stat-pill-blue {
  background: #3b82f6;
}

.stat-pill-orange {
  background: #fb7185;
}

.stat-pill-green {
  background: #22c55e;
}

.stat-count {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.wallet-card {
  background: linear-gradient(135deg, #fff8e7 0%, #fffdf7 48%, #ffffff 100%);
}

.wallet-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.wallet-label {
  display: block;
  font-size: 22rpx;
  color: #8b5e18;
}

.wallet-balance {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #7c4700;
}

.wallet-link {
  font-size: 22rpx;
  color: #8b5e18;
}

.wallet-metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(124, 71, 0, 0.08);
}

.wallet-metric {
  width: 32%;
}

.wallet-metric-value {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.wallet-metric-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #7c8798;
}

.latest-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.latest-order-body,
.latest-empty {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f7fafc;
}

.latest-order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.latest-order-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-order-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
}

.latest-order-status-pending {
  color: #9a6700;
  background: #fff4d6;
}

.latest-order-status-processing {
  color: #0f6dcf;
  background: #e8f2ff;
}

.latest-order-status-warning {
  color: #c2410c;
  background: #ffedd5;
}

.latest-order-status-finished {
  color: #15803d;
  background: #dcfce7;
}

.latest-order-name,
.latest-empty-text {
  display: block;
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.latest-order-sub,
.latest-empty-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.quick-entry {
  width: 48.5%;
  margin-bottom: 18rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #f8fafc;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.quick-icon-blue {
  color: #0f6dcf;
  background: #e8f2ff;
}

.quick-icon-green {
  color: #15803d;
  background: #dcfce7;
}

.quick-icon-orange {
  color: #c2410c;
  background: #ffedd5;
}

.quick-icon-purple {
  color: #7c3aed;
  background: #f3e8ff;
}

.quick-title {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.quick-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.menu-list {
  margin-top: 18rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #eef2f7;
}

.menu-main {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.menu-arrow {
  margin-left: 18rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.promise-card {
  margin-bottom: 28rpx;
}

.promise-list {
  margin-top: 20rpx;
}

.promise-item {
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
}

.promise-item + .promise-item {
  margin-top: 16rpx;
}

.promise-item-blue {
  background: linear-gradient(135deg, #edf5ff 0%, #f8fbff 100%);
}

.promise-item-orange {
  background: linear-gradient(135deg, #fff4e9 0%, #fffaf5 100%);
}

.promise-item-green {
  background: linear-gradient(135deg, #ebfff4 0%, #f8fffb 100%);
}

.promise-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.promise-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.brand-card {
  background: linear-gradient(135deg, #f7fbff 0%, #ffffff 52%, #f9fcff 100%);
}

.brand-card-head {
  display: flex;
  align-items: center;
}

.brand-card-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.brand-card-main {
  margin-left: 18rpx;
  display: flex;
  flex-direction: column;
}

.brand-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #12355b;
}

.brand-card-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5f7b99;
  line-height: 1.5;
}

.brand-chip-row {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.brand-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1677ff;
  background-color: #eaf3ff;
}

.brand-card-copy {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #334155;
}
