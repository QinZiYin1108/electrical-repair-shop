@import "../common.wxss";

.address-list {
  margin-top: 10rpx;
}

.address-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 14rpx;
}

.address-item + .address-item {
  margin-top: 10rpx;
}

.address-item-active {
  border-color: #1677ff;
  background-color: #eef5ff;
}

.address-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.address-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #111827;
}

.address-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tech-list {
  margin-top: 10rpx;
}

.tech-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 14rpx;
}

.tech-item + .tech-item {
  margin-top: 10rpx;
}

.tech-item-active {
  border-color: #1677ff;
  background-color: #eef5ff;
}

.tech-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tech-name-wrap {
  display: flex;
  align-items: center;
}

.tech-name-wrap .van-tag {
  margin-left: 10rpx;
}

.tech-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.tech-distance {
  font-size: 22rpx;
  color: #1677ff;
}

.tech-meta {
  margin: 8rpx 0 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tech-meta-item {
  margin-right: 14rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.all-tech-entry {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.all-tech-text {
  color: #64748b;
}
