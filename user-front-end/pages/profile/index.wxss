.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.avatar-wrapper {
  margin-right: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #f2f3f5;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #969799;
}

.avatar-placeholder {
  font-weight: 500;
}

.base-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #969799;
}

.profile-body {
  margin-top: 24rpx;
}

.profile-actions {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.section-title {
  margin: 12rpx 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #323233;
}
