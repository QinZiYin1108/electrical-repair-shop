---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="联系我们" description="联系安修到家客服，预约电器维修服务。微信小程序搜索「安修到家」或拨打客服热线。">
  <section class="page-hero">
    <div class="container">
      <h1>联系我们</h1>
      <p>随时为您服务，预约维修或咨询答疑</p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2>联系方式</h2>
        <div class="contact-list">
          <div class="contact-item">
            <span class="contact-icon">📞</span>
            <div>
              <strong>客服热线</strong>
              <p>400-XXX-XXXX</p>
              <span class="contact-sub">服务时间：每天 8:00 - 20:00</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📧</span>
            <div>
              <strong>电子邮箱</strong>
              <p>support@leonyin.cn</p>
              <span class="contact-sub">我们将在 24 小时内回复</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">💬</span>
            <div>
              <strong>微信公众号</strong>
              <p>安修到家</p>
              <span class="contact-sub">关注公众号，在线客服随时咨询</span>
            </div>
          </div>
          <div class="contact-item">
            <span class="contact-icon">📱</span>
            <div>
              <strong>微信小程序</strong>
              <p>搜索「安修到家」</p>
              <span class="contact-sub">一键预约维修，查看订单进度</span>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form">
        <h2>在线留言</h2>
        <p class="form-subtitle">留下您的需求，客服将尽快与您联系</p>

        <form class="form" id="contactForm">
          <div class="form-group">
            <label for="name">姓名 *</label>
            <input type="text" id="name" name="name" placeholder="请输入您的姓名" required />
          </div>
          <div class="form-group">
            <label for="phone">手机号 *</label>
            <input type="tel" id="phone" name="phone" placeholder="请输入您的手机号" required />
          </div>
          <div class="form-group">
            <label for="category">维修品类</label>
            <select id="category" name="category">
              <option value="">请选择</option>
              <option value="空调">空调</option>
              <option value="冰箱">冰箱</option>
              <option value="洗衣机">洗衣机</option>
              <option value="电视">电视</option>
              <option value="热水器">热水器</option>
              <option value="厨房电器">厨房电器</option>
              <option value="小家电">小家电</option>
              <option value="其他">其他</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">故障描述 *</label>
            <textarea id="message" name="message" rows="4" placeholder="请简要描述电器故障现象……" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;padding:16px;">
            提交留言 →
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--color-bg-alt);text-align:center;">
    <div class="container">
      <h2 class="section-title">更多方式找到我们</h2>
      <p class="section-subtitle">扫码或搜索，随时随地预约维修</p>
      <div class="qr-row">
        <div class="qr-card">
          <div class="qr-placeholder">📱</div>
          <p>微信小程序</p>
          <span>搜索「安修到家」</span>
        </div>
        <div class="qr-card">
          <div class="qr-placeholder">💬</div>
          <p>微信公众号</p>
          <span>搜索「安修到家」</span>
        </div>
        <div class="qr-card">
          <div class="qr-placeholder">📞</div>
          <p>客服电话</p>
          <span>400-XXX-XXXX</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.page-hero {
  background: linear-gradient(135deg, var(--color-primary), #6366F1);
  color: #fff;
  padding: 120px 0 64px;
  text-align: center;
}
.page-hero h1 {
  font-size: 2.5rem;
  font-weight: 800;
  margin-bottom: 8px;
}
.page-hero p {
  font-size: 1.1rem;
  opacity: .85;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
}

.contact-info h2,
.contact-form h2 {
  font-size: 1.5rem;
  margin-bottom: 24px;
}

.contact-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.contact-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.contact-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  width: 48px;
  height: 48px;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
}

.contact-item strong {
  display: block;
  font-size: .95rem;
  margin-bottom: 4px;
}

.contact-item p {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--color-primary);
}

.contact-sub {
  font-size: .85rem;
  color: var(--color-text-secondary);
}

.form-subtitle {
  color: var(--color-text-secondary);
  font-size: .95rem;
  margin-bottom: 24px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: .92rem;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--color-text);
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: .95rem;
  font-family: inherit;
  color: var(--color-text);
  transition: border-color .25s;
  background: #fff;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-light);
}

.qr-row {
  display: flex;
  justify-content: center;
  gap: 48px;
  flex-wrap: wrap;
}

.qr-card {
  text-align: center;
}

.qr-placeholder {
  width: 120px;
  height: 120px;
  background: #fff;
  border: 2px dashed var(--color-border);
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  margin: 0 auto 12px;
}

.qr-card p {
  font-weight: 600;
  margin-bottom: 4px;
}

.qr-card span {
  font-size: .88rem;
  color: var(--color-text-secondary);
}

@media (max-width: 768px) {
  .contact-grid { grid-template-columns: 1fr; }
}
</style>
