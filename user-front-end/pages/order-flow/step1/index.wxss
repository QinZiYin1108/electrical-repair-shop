@import "../common.wxss";

.mode-list {
  margin-top: 12rpx;
}

.mode-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 16rpx;
}

.mode-item + .mode-item {
  margin-top: 12rpx;
}

.mode-item-active {
  border-color: #1677ff;
  background-color: #edf4ff;
}

.mode-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mode-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.mode-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #64748b;
}

.one-btn .van-button {
  width: 100%;
}
