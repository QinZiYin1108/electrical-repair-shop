<view class="page message-detail-page">
  <block wx:if="{{type === 'system'}}">
    <view class="message-list">
      <block wx:for="{{systemMessages}}" wx:key="id" wx:for-item="item">
        <view class="message-item system-message-item">
          <view class="message-meta">
            <text class="message-title">{{item.title}}</text>
            <text class="message-time">{{item.createdTimeText}}</text>
          </view>
          <view class="message-content">{{item.content}}</view>
        </view>
      </block>
      <view wx:if="{{!loading && systemMessages.length === 0}}" class="empty-tip">暂无消息</view>
    </view>
  </block>

  <block wx:else>
    <view class="chat-header">{{sessionTitle}}</view>
    <view wx:if="{{!canSend}}" class="chat-tip">当前会话已结束，如需沟通请联系平台客服</view>
    <scroll-view scroll-y class="chat-scroll" scroll-into-view="{{scrollIntoView}}">
      <view class="chat-list">
        <block wx:for="{{chatMessages}}" wx:key="id" wx:for-item="msg">
          <view wx:if="{{msg.showTimeDivider}}" class="time-divider">{{msg.timeDividerText}}</view>
          <view id="msg-{{msg.id}}" class="message-row {{msg.isSelf ? 'message-row-self' : 'message-row-other'}}">
            <view class="message-block">
              <view class="message-bubble {{msg.bubbleType !== 'text' ? 'message-bubble-media' : ''}}">
                <text wx:if="{{msg.bubbleType === 'text'}}" class="bubble-text">{{msg.content}}</text>
                <image
                  wx:elif="{{msg.bubbleType === 'image'}}"
                  class="bubble-image"
                  src="{{msg.imageUrl}}"
                  mode="widthFix"
                  data-url="{{msg.imageUrl}}"
                  bind:tap="onPreviewImage"
                />
                <video
                  wx:elif="{{msg.bubbleType === 'video'}}"
                  class="bubble-video"
                  src="{{msg.videoUrl}}"
                  poster="{{msg.thumbnailUrl}}"
                  controls
                  objectFit="cover"
                />
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{!loading && chatMessages.length === 0}}" class="empty-tip">暂无消息</view>
      </view>
    </scroll-view>

    <view class="composer {{!canSend ? 'composer-disabled' : ''}}">
      <view class="composer-tool" bind:tap="onChooseImage">
        <van-icon name="photo-o" size="22px" color="#334155" />
      </view>
      <view class="composer-tool" bind:tap="onChooseVideo">
        <van-icon name="video-o" size="22px" color="#334155" />
      </view>
      <input
        class="composer-input"
        value="{{messageInput}}"
        maxlength="1000"
        placeholder="请输入消息"
        confirm-type="send"
        bindinput="onMessageInput"
        bindconfirm="onSendTap"
        disabled="{{!canSend || sending || uploadBusy}}"
      />
      <view class="composer-send {{(messageInput && canSend) ? 'composer-send-active' : ''}}" bind:tap="onSendTap">
        {{sending ? '发送中' : '发送'}}
      </view>
    </view>
  </block>
</view>
