.after-sales-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f7fb 0%, #eef3f9 100%);
}

.state-card,
.hero-card,
.section-card {
  border-radius: 24rpx;
  background-color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.06);
}

.state-card {
  padding: 32rpx 28rpx;
  text-align: center;
}

.state-text,
.state-desc,
.field-tip,
.video-meta,
.media-empty,
.empty-text {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.state-title,
.section-title,
.hero-title {
  color: #0f172a;
  font-weight: 600;
}

.state-title,
.section-title {
  font-size: 30rpx;
}

.primary-btn,
.ghost-btn,
.hero-action,
.video-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

.retry-btn {
  min-width: 200rpx;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
}

.hero-card {
  padding: 28rpx;
  background: linear-gradient(135deg, #155eef 0%, #0f766e 100%);
  color: #ffffff;
}

.hero-head,
.section-head,
.info-row,
.video-card-foot {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-head {
  align-items: center;
}

.hero-title {
  font-size: 34rpx;
  color: #ffffff;
}

.hero-order,
.hero-status {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
  word-break: break-all;
}

.hero-service {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.hero-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.section-head {
  align-items: center;
  margin-bottom: 8rpx;
}

.status-badge {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background-color: #ecfeff;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 600;
}

.info-row + .info-row,
.media-block + .media-block {
  margin-top: 18rpx;
}

.info-label {
  flex-shrink: 0;
  width: 144rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: right;
  word-break: break-all;
}

.tip-block {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.7;
}

.field-title,
.media-title {
  margin-top: 24rpx;
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.field-title:first-of-type {
  margin-top: 0;
}

.field-tip {
  margin-top: 8rpx;
}

.chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dbe4ef;
  background-color: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.4;
}

.chip-active {
  border-color: #0f766e;
  background-color: #ecfeff;
  color: #0f766e;
}

.desc-textarea {
  width: 100%;
  min-height: 200rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #dbe4ef;
  background-color: #f8fafc;
  box-sizing: border-box;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
}

.media-block {
  margin-top: 22rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.upload-image-wrap,
.upload-trigger,
.image-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
}

.upload-image-wrap {
  position: relative;
}

.image-item {
  background-color: #e5e7eb;
}

.delete-tag {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  z-index: 2;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.upload-trigger {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cbd5e1;
  background-color: #f8fafc;
  box-sizing: border-box;
}

.upload-trigger-plus {
  color: #0f766e;
  font-size: 44rpx;
  line-height: 1;
}

.upload-trigger-text {
  margin-top: 12rpx;
  color: #475569;
  font-size: 22rpx;
}

.video-trigger {
  width: 100%;
  height: 220rpx;
}

.video-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
}

.upload-video-wrap {
  position: relative;
}

.video-player {
  width: 100%;
  height: 320rpx;
  border-radius: 18rpx;
  background-color: #0f172a;
}

.video-card-foot {
  align-items: center;
  margin-top: 14rpx;
}

.video-actions {
  flex-shrink: 0;
}

.video-link {
  padding: 10rpx 18rpx;
  background-color: #e2e8f0;
  color: #475569;
  font-size: 22rpx;
}

.submit-btn,
.ghost-btn {
  width: 100%;
  margin-top: 28rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.ghost-btn {
  border: 2rpx solid #f97316;
  color: #ea580c;
  background-color: #fff7ed;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-card {
  text-align: center;
}
