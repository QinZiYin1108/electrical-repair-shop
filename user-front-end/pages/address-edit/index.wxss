.page {
  position: relative;
  min-height: 100vh;
  background: #e9eef3;
  overflow: hidden;
}

.map-background {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100vh;
}

.map-center-pin {
  position: fixed;
  left: 50%;
  top: 36vh;
  transform: translate(-50%, -100%);
  pointer-events: none;
  z-index: 9;
}

.pin-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #00b578;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(0, 181, 120, 0.3);
}

.relocate-btn {
  position: fixed;
  right: 24rpx;
  top: calc(env(safe-area-inset-top) + 24rpx);
  z-index: 10;
}

.floating-panel {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  z-index: 10;
  padding: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(12, 33, 61, 0.18);
  backdrop-filter: blur(6px);
  transition: transform 220ms ease, box-shadow 220ms ease;
}

.floating-panel--dragging {
  transform: translateY(320rpx) scale(0.98);
  opacity: 0.9;
  box-shadow: 0 8rpx 24rpx rgba(12, 33, 61, 0.1);
}

.panel-tip {
  margin: 0 12rpx 14rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5f6470;
}

.switch-row {
  margin: 22rpx 8rpx 0;
  padding: 20rpx 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  font-size: 28rpx;
  color: #323233;
}

.footer-actions {
  margin-top: 24rpx;
  padding: 0 8rpx 8rpx;
}
