<view class="page mine-page">
  <view class="hero-section">
    <view class="hero-decoration hero-decoration-left"></view>
    <view class="hero-decoration hero-decoration-right"></view>

    <view class="profile-card">
      <view class="profile-main" bind:tap="onHeaderTap">
        <view class="avatar-shell">
          <image
            wx:if="{{isLogin && user.avatarUrl}}"
            class="avatar"
            src="{{user.avatarUrl}}"
            mode="aspectFill"
          />
          <view
            wx:else
            class="avatar avatar-placeholder"
          >
            {{isLogin ? (user.username || texts.userFallback) : texts.login}}
          </view>
        </view>

        <view class="user-base">
          <view class="user-top-row">
            <text class="user-name">{{isLogin ? (user.username || texts.unsetName) : texts.notLoggedIn}}</text>
            <text class="user-tag">{{isLogin ? texts.memberTag : texts.guestTag}}</text>
          </view>
          <text class="user-sub">{{isLogin ? (user.phone || texts.userSub) : texts.guestSub}}</text>
        </view>

        <view class="profile-arrow">></view>
      </view>

      <view wx:if="{{isLogin}}" class="completion-card">
        <view class="completion-row">
          <text class="completion-label">{{texts.safetyTip}}</text>
          <text class="completion-value">{{profileCompletion}}%</text>
        </view>
        <view class="completion-track">
          <view class="completion-bar" style="width: {{profileCompletion}}"></view>
        </view>
      </view>

      <view wx:else class="guest-copy">
        <text class="guest-title">{{texts.guestCardTitle}}</text>
        <text class="guest-sub">{{texts.guestCardSub}}</text>
      </view>

      <view class="hero-actions">
        <view class="hero-action-card" bind:tap="onNavigateProfile">
          <text class="hero-action-title">{{texts.editProfile}}</text>
          <text class="hero-action-sub">完善账号资料</text>
        </view>
        <view class="hero-action-card" bind:tap="onNavigateAddress">
          <text class="hero-action-title">{{texts.manageAddress}}</text>
          <text class="hero-action-sub">维护服务地址</text>
        </view>
      </view>

      <view wx:if="{{!isLogin}}" class="guest-action-row">
        <van-button type="primary" round bind:tap="onLoginTap">{{texts.wechatLogin}}</van-button>
        <van-button plain round bind:tap="onGoRepairTap">{{texts.goRepair}}</van-button>
      </view>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="section-card stats-card">
    <view class="section-head">
      <text class="section-title">{{texts.orderCenter}}</text>
      <text class="section-link" bind:tap="onNavigateOrders">{{texts.moreAction}}</text>
    </view>
    <view class="stats-grid">
      <view
        wx:for="{{orderStats}}"
        wx:key="key"
        class="stat-item"
        data-tab="{{item.key}}"
        bind:tap="onOrderStatTap"
      >
        <view class="stat-pill stat-pill-{{item.theme}}"></view>
        <text class="stat-count">{{item.count}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{isLogin}}" class="section-card wallet-card" bind:tap="onNavigateFunds">
    <view class="wallet-top">
      <view>
        <text class="wallet-label">{{texts.fundsBalance}}</text>
        <text class="wallet-balance">￥{{walletSummary.balance}}</text>
      </view>
      <text class="wallet-link">{{texts.walletCenter}} ></text>
    </view>
    <view class="wallet-metrics">
      <view class="wallet-metric">
        <text class="wallet-metric-value">￥{{walletSummary.frozenBalance}}</text>
        <text class="wallet-metric-label">{{texts.frozenBalance}}</text>
      </view>
      <view class="wallet-metric">
        <text class="wallet-metric-value">￥{{walletSummary.totalIncome}}</text>
        <text class="wallet-metric-label">{{texts.totalIncome}}</text>
      </view>
      <view class="wallet-metric">
        <text class="wallet-metric-value">￥{{walletSummary.totalExpense}}</text>
        <text class="wallet-metric-label">{{texts.totalExpense}}</text>
      </view>
    </view>
  </view>

  <view class="section-card latest-card" bind:tap="onLatestOrderTap">
    <view class="section-head">
      <text class="section-title">{{texts.latestOrderTitle}}</text>
      <text class="section-link">{{texts.moreAction}}</text>
    </view>

    <view wx:if="{{isLogin && latestOrder}}" class="latest-order-body">
      <view class="latest-order-top">
        <text class="latest-order-no">订单 {{latestOrder.orderNo}}</text>
        <text class="latest-order-status latest-order-status-{{latestOrder.tone}}">{{latestOrder.statusText}}</text>
      </view>
      <text class="latest-order-name">{{latestOrder.appliance}}</text>
      <text class="latest-order-sub">点击查看订单详情和最新进度</text>
    </view>

    <view wx:else class="latest-empty">
      <text class="latest-empty-text">{{texts.latestOrderEmpty}}</text>
      <text class="latest-empty-sub">现在去下单，平台会自动为你匹配合适师傅</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">{{texts.quickToolsTitle}}</text>
    </view>
    <view class="quick-grid">
      <view
        wx:for="{{quickEntries}}"
        wx:key="key"
        class="quick-entry"
        data-key="{{item.key}}"
        bind:tap="onQuickEntryTap"
      >
        <view class="quick-icon quick-icon-{{item.theme}}">
          <van-icon name="{{item.icon}}" size="30rpx" />
        </view>
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-sub">{{item.subtitle}}</text>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">{{texts.accountTitle}}</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bind:tap="onNavigateProfile">
        <view class="menu-main">
          <text class="menu-title">{{texts.profile}}</text>
          <text class="menu-desc">{{texts.profileDesc}}</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
      <view class="menu-item" bind:tap="onNavigateSettings">
        <view class="menu-main">
          <text class="menu-title">{{texts.settings}}</text>
          <text class="menu-desc">{{texts.settingsDesc}}</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="section-card promise-card">
    <view class="section-head">
      <text class="section-title">{{texts.serviceTitle}}</text>
    </view>
    <view class="promise-list">
      <view
        wx:for="{{servicePromises}}"
        wx:key="title"
        class="promise-item promise-item-{{item.theme}}"
      >
        <text class="promise-title">{{item.title}}</text>
        <text class="promise-sub">{{item.subtitle}}</text>
      </view>
    </view>
  </view>
</view>
