.credit-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.score-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.score-normal { background: linear-gradient(135deg, #67c23a, #85ce61); }
.score-warning { background: linear-gradient(135deg, #e6a23c, #ebb563); }
.score-danger { background: linear-gradient(135deg, #f56c6c, #f78989); }

.score-value {
  font-size: 80rpx;
  font-weight: 700;
}

.score-label {
  font-size: 28rpx;
  opacity: .85;
  margin-top: 8rpx;
}

.score-status {
  font-size: 24rpx;
  opacity: .7;
  margin-top: 12rpx;
  padding: 6rpx 24rpx;
  background: rgba(255,255,255,.2);
  border-radius: 999rpx;
}

.score-tips {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.tip-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tip-row:last-child { margin-bottom: 0; }

.tip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-dot-normal { background-color: #67c23a; }
.tip-dot-warning { background-color: #e6a23c; }
.tip-dot-danger { background-color: #f56c6c; }

.tip-text {
  font-size: 24rpx;
  color: #606266;
}

.history-section {
  margin: 16rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303133;
  margin-bottom: 16rpx;
}

.history-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-change {
  font-size: 36rpx;
  font-weight: 700;
}

.positive { color: #67c23a; }
.negative { color: #f56c6c; }

.history-body {
  padding: 16rpx 0;
}

.history-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.history-label {
  font-size: 26rpx;
  color: #909399;
  flex-shrink: 0;
}

.history-value {
  font-size: 26rpx;
  color: #303133;
}

.history-arrow {
  margin: 0 8rpx;
  color: #c0c4cc;
}

.after-normal { color: #67c23a; font-weight: 600; }
.after-warning { color: #e6a23c; font-weight: 600; }
.after-danger { color: #f56c6c; font-weight: 600; }

.history-footer {
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.history-time {
  font-size: 24rpx;
  color: #c0c4cc;
}

.loading-area {
  display: flex;
  justify-content: center;
  padding: 60rpx;
}

.loading-more {
  display: flex;
  justify-content: center;
  padding: 20rpx;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}
