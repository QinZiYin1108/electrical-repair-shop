.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f7fbff 0%, #eef3f8 30%, #f5f5f5 100%);
}

.wallet-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1ab66b 0%, #1098c8 100%);
  box-shadow: 0 18rpx 40rpx rgba(16, 152, 200, 0.18);
  color: #ffffff;
}

.wallet-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.wallet-glow-left {
  width: 180rpx;
  height: 180rpx;
  left: -40rpx;
  top: -20rpx;
}

.wallet-glow-right {
  width: 240rpx;
  height: 240rpx;
  right: -60rpx;
  bottom: -120rpx;
}

.hero-top,
.hero-stats {
  position: relative;
  z-index: 1;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.hero-balance {
  margin-top: 10rpx;
  font-size: 64rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.hero-stats {
  display: flex;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.hero-stat {
  flex: 1;
}

.hero-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.74);
}

.hero-stat-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #20242a;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.update-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #97a0af;
}

.method-list {
  margin-top: 20rpx;
}

.method-card {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  border: 2rpx solid #edf1f5;
  background: #fafbfd;
}

.method-card + .method-card {
  margin-top: 16rpx;
}

.method-card--active {
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(21, 101, 192, 0.08);
}

.wechat-active {
  border-color: rgba(26, 182, 107, 0.34);
}

.alipay-active {
  border-color: rgba(16, 152, 200, 0.32);
}

.method-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.wechat-icon {
  background: linear-gradient(135deg, #1ab66b 0%, #25c575 100%);
}

.alipay-icon {
  background: linear-gradient(135deg, #1098c8 0%, #3fa9f5 100%);
}

.method-body {
  flex: 1;
  margin-left: 18rpx;
}

.method-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #20242a;
}

.method-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.method-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #c9d2de;
  background: #ffffff;
}

.method-check--active {
  border-color: #1ab66b;
  background: radial-gradient(circle at center, #1ab66b 0, #1ab66b 44%, #ffffff 48%, #ffffff 100%);
}

.amount-panel {
  margin-top: 24rpx;
}

.amount-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #4d5563;
}

.quick-amounts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.quick-chip {
  min-width: 132rpx;
  padding: 16rpx 22rpx;
  border-radius: 18rpx;
  border: 2rpx solid #edf1f5;
  background: #fafbfd;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 600;
  color: #4d5563;
  text-align: center;
}

.quick-chip--active {
  color: #1098c8;
  border-color: rgba(16, 152, 200, 0.28);
  background: rgba(16, 152, 200, 0.06);
}

.custom-input {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 12rpx 20rpx;
  border-radius: 22rpx;
  background: #f7f9fc;
}

.currency-symbol {
  margin-right: 10rpx;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 700;
  color: #20242a;
}

.submit-box {
  margin-top: 22rpx;
}

.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-main {
  flex: 1;
}

.action-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #20242a;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.action-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #97a0af;
}

.action-divider {
  height: 1rpx;
  margin: 22rpx 0 20rpx;
  background: #eef2f6;
}

.note-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #4d5563;
}

.note-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #8a94a6;
}

.amount-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  font-size: 30rpx;
  color: #20242a;
}

.amount-input::placeholder {
  color: #a1a9b6;
}
