<view class="page mall-page">
  <view class="hero-section">
    <view class="hero-decoration hero-decoration-left"></view>
    <view class="hero-decoration hero-decoration-right"></view>

    <view class="hero-card">
      <view class="hero-top">
        <view>
          <view class="hero-title">电器商城</view>
          <view class="hero-subtitle">{{activeTypeDesc}}</view>
        </view>
        <view class="hero-count">{{products.length}}件在售</view>
      </view>

      <view class="search-row">
        <view class="search-bar">
          <van-icon name="search" size="18" color="#94a3b8" />
          <input
            class="search-input"
            placeholder="搜索商品名称 / 品牌 / 型号"
            confirm-type="search"
            value="{{inputKeyword}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
          />
          <text wx:if="{{inputKeyword}}" class="search-clear" bind:tap="onClearSearch">清空</text>
        </view>
        <view class="search-btn" bind:tap="onSearchConfirm">查询</view>
      </view>

      <view class="type-tab-row">
        <view
          wx:for="{{productTypeTabs}}"
          wx:key="id"
          class="type-tab {{activeProductType === item.id ? 'type-tab-active' : ''}}"
          data-type="{{item.id}}"
          bind:tap="onSwitchProductType"
        >
          <text class="type-tab-title">{{item.title}}</text>
          <text class="type-tab-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card result-card">
    <view class="result-top">
      <view>
        <text class="section-title">{{activeTypeTitle}}</text>
        <text class="result-sub">{{resultSummaryText}}</text>
      </view>
      <view class="filter-btn" bind:tap="openFilterDrawer">
        <van-icon name="filter-o" size="18" color="#1677ff" />
        <text>筛选</text>
        <text wx:if="{{activeFilterItems.length}}" class="filter-badge">{{activeFilterItems.length}}</text>
      </view>
    </view>

    <scroll-view
      wx:if="{{activeFilterItems.length}}"
      class="active-filter-scroll"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="active-filter-list">
        <view wx:for="{{activeFilterItems}}" wx:key="id" class="active-filter-chip">
          {{item.text}}
        </view>
        <view class="active-filter-reset" bind:tap="onResetFilters">清空筛选</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="section-card loading-card">
    <van-loading size="24px" color="#1677ff" />
    <text class="loading-text">商品加载中...</text>
  </view>

  <view wx:elif="{{products.length}}" class="product-grid">
    <view
      wx:for="{{products}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
      bind:tap="onProductTap"
    >
      <view class="product-media">
        <image
          wx:if="{{item.mainImageUrl}}"
          class="product-image"
          src="{{item.mainImageUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="product-image-empty">暂无图片</view>

        <view class="badge-list">
          <text wx:if="{{item.isRecommended}}" class="product-badge badge-recommend">推荐</text>
          <text wx:if="{{item.isHot}}" class="product-badge badge-hot">热销</text>
          <text wx:if="{{item.isNew}}" class="product-badge badge-new">新品</text>
        </view>
      </view>

      <view class="product-body">
        <text class="product-name">{{item.name}}</text>
        <text class="product-meta">{{item.brand || "品牌待补充"}} / {{item.model || "型号待补充"}}</text>
        <text wx:if="{{item.categoryPath}}" class="product-path">{{item.categoryPath}}</text>

        <view class="price-row">
          <text class="price-current">￥{{item.sellingPriceText}}</text>
          <text class="price-original">￥{{item.originalPriceText}}</text>
        </view>

        <view class="product-flag-row">
          <text class="product-flag">{{item.isFreeShipping ? "包邮" : "需运费"}}</text>
          <text class="product-flag">已售 {{item.salesCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="section-card empty-card">
    <view class="empty-title">暂无符合条件的商品</view>
    <view class="empty-desc">你可以重新设置筛选条件，或清空条件后查看全部商品</view>
    <view class="empty-btn" bind:tap="onResetFilters">恢复默认筛选</view>
  </view>

  <van-popup
    show="{{showFilterDrawer}}"
    position="right"
    close-on-click-overlay
    bind:close="closeFilterDrawer"
    custom-style="width: 620rpx; height: 100%;"
  >
    <view class="drawer-panel">
      <view class="drawer-head">
        <view>
          <view class="drawer-title">条件筛选</view>
          <view class="drawer-subtitle">按分类、价格、标签和排序组合查找</view>
        </view>
        <view class="drawer-close" bind:tap="closeFilterDrawer">关闭</view>
      </view>

      <scroll-view class="drawer-body" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="drawer-section">
          <view class="drawer-label">分类</view>
          <view class="drawer-chip-row">
            <view
              class="drawer-chip {{draftSelectedCategoryId ? '' : 'drawer-chip-active'}}"
              data-id=""
              data-name=""
              bind:tap="onDrawerCategoryTap"
            >
              全部分类
            </view>
            <view
              wx:for="{{categories}}"
              wx:key="id"
              class="drawer-chip {{draftSelectedCategoryId === item.id ? 'drawer-chip-active' : ''}}"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              bind:tap="onDrawerCategoryTap"
            >
              {{item.name}}
            </view>
          </view>
        </view>

        <view class="drawer-section">
          <view class="drawer-label">快捷条件</view>
          <view class="drawer-chip-row">
            <view
              class="drawer-chip {{draftOnlyInStock ? 'drawer-chip-active' : ''}}"
              data-key="draftOnlyInStock"
              bind:tap="onDrawerSwitchTap"
            >
              仅看有货
            </view>
            <view
              class="drawer-chip {{draftOnlyFreeShipping ? 'drawer-chip-active' : ''}}"
              data-key="draftOnlyFreeShipping"
              bind:tap="onDrawerSwitchTap"
            >
              只看包邮
            </view>
          </view>
        </view>

        <view class="drawer-section">
          <view class="drawer-label">价格区间</view>
          <view class="drawer-chip-row">
            <view
              wx:for="{{priceRangeOptions}}"
              wx:key="value"
              class="drawer-chip {{draftActivePriceRange === item.value ? 'drawer-chip-active' : ''}}"
              data-value="{{item.value}}"
              data-min="{{item.min}}"
              data-max="{{item.max}}"
              bind:tap="onDrawerPriceRangeSelect"
            >
              {{item.label}}
            </view>
          </view>
          <view class="drawer-input-row">
            <input
              class="drawer-input"
              type="digit"
              placeholder="最低价"
              value="{{draftInputMinPrice}}"
              bindinput="onDrawerMinPriceInput"
            />
            <text class="drawer-input-sep">-</text>
            <input
              class="drawer-input"
              type="digit"
              placeholder="最高价"
              value="{{draftInputMaxPrice}}"
              bindinput="onDrawerMaxPriceInput"
            />
          </view>
        </view>

        <view class="drawer-section">
          <view class="drawer-label">商品标签</view>
          <view class="drawer-chip-row">
            <view
              wx:for="{{marketingTagOptions}}"
              wx:key="value"
              class="drawer-chip {{draftActiveMarketingTag === item.value ? 'drawer-chip-active' : ''}}"
              data-value="{{item.value}}"
              bind:tap="onDrawerMarketingTagSelect"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <view class="drawer-section drawer-section-last">
          <view class="drawer-label">排序方式</view>
          <view class="drawer-chip-row">
            <view
              wx:for="{{sortOptions}}"
              wx:key="value"
              class="drawer-chip {{draftActiveSort === item.value ? 'drawer-chip-active' : ''}}"
              data-value="{{item.value}}"
              bind:tap="onDrawerSortSelect"
            >
              {{item.label}}
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="drawer-footer">
        <view class="drawer-btn drawer-btn-ghost" bind:tap="onDrawerReset">重置</view>
        <view class="drawer-btn drawer-btn-primary" bind:tap="onApplyDrawerFilters">确认筛选</view>
      </view>
    </view>
  </van-popup>
</view>
