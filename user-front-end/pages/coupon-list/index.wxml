<view class="page coupon-page">
  <view class="hero-card">
    <view>
      <view class="hero-title">我的优惠券</view>
      <view class="hero-subtitle">已领取的优惠券会在下单结算时自动匹配。</view>
    </view>
    <view class="hero-badge">{{couponList.length}} 张</view>
  </view>

  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="false">
    <view class="tab-list">
      <view wx:for="{{tabs}}" wx:key="key" class="tab-item {{item.active ? 'tab-item-active' : ''}}" data-key="{{item.key}}" bind:tap="onTabTap">
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <text class="state-text">正在加载优惠券...</text>
  </view>

  <view wx:elif="{{loadError}}" class="section-card state-card">
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn" bind:tap="onRetryTap">重新加载</view>
  </view>

  <block wx:elif="{{couponList.length}}">
    <view wx:for="{{couponList}}" wx:key="id" class="section-card coupon-card coupon-card-status-{{item.status}}">
      <view class="coupon-top">
        <view>
          <view class="coupon-name">{{item.name}}</view>
          <view class="coupon-type">{{item.typeText}} / {{item.applicableTypeText}}</view>
        </view>
        <view class="coupon-status">{{item.statusText}}</view>
      </view>
      <view class="coupon-discount">{{item.discountText}}</view>
      <view class="coupon-meta">满 ￥{{item.minAmountText}} 可用</view>
      <view class="coupon-meta">领取时间：{{item.receiveTimeText}}</view>
      <view class="coupon-meta">到期时间：{{item.expireTimeText}}</view>
      <view wx:if="{{item.disabledReason}}" class="coupon-tip">{{item.disabledReason}}</view>
    </view>
  </block>

  <view wx:else class="section-card state-card">
    <view class="state-title">暂无优惠券</view>
    <view class="state-desc">下单活动或管理员发放的优惠券会展示在这里。</view>
  </view>
</view>
