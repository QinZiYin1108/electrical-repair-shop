<view class="page order-detail-page">
  <view wx:if="{{loading}}" class="section-card state-card">
    <text class="state-text">{{texts.loading}}</text>
  </view>

  <view wx:elif="{{loadError}}" class="section-card state-card">
    <view class="state-title">{{texts.loadFailed}}</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn" bind:tap="onRetryTap">{{texts.retry}}</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="hero-card">
      <view class="hero-head">
        <view>
          <view class="hero-status">{{detail.orderStatusText}}</view>
          <view class="hero-sub">{{detail.deliveryStatusText}} / {{detail.paymentStatusText}}</view>
        </view>
        <view class="copy-link" bind:tap="onCopyOrderNoTap">{{texts.copyOrderNo}}</view>
      </view>
      <view class="hero-title">{{detail.productSummary}}</view>
      <view class="hero-no">{{detail.orderNo}}</view>
      <view class="hero-amount">实付 ￥{{detail.actualAmountText}}</view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">收货信息</view>
      </view>
      <view wx:for="{{shippingRows}}" wx:key="label" class="info-row">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">商品清单</view>
      </view>
      <view
        wx:for="{{detail.items}}"
        wx:key="id"
        class="goods-item"
        data-product-id="{{item.productId}}"
        bind:tap="onProductTap"
      >
        <view class="goods-media">
          <image wx:if="{{item.productImage}}" class="goods-image" src="{{item.productImage}}" mode="aspectFill" />
          <view wx:else class="goods-image-empty">暂无图片</view>
        </view>
        <view class="goods-main">
          <text class="goods-name">{{item.productName}}</text>
          <text class="goods-meta">单价 ￥{{item.productPriceText}}</text>
          <text class="goods-meta">数量 x{{item.quantity}}</text>
        </view>
        <view class="goods-total">￥{{item.totalPriceText}}</view>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">金额明细</view>
      </view>
      <view wx:for="{{amountRows}}" wx:key="label" class="info-row">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value {{item.strong ? 'info-value-strong' : ''}}">{{item.value}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view class="section-title">订单信息</view>
      </view>
      <view wx:for="{{extraRows}}" wx:key="label" class="info-row">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
      <view wx:if="{{detail.afterSalesApplication}}" class="info-row">
        <text class="info-label">售后状态</text>
        <text class="info-value">{{detail.afterSalesApplication.statusText}}</text>
      </view>
    </view>

    <view class="bottom-space"></view>

    <view class="action-bar">
      <view class="action-chip action-chip-secondary" bind:tap="onGoMallTap">{{texts.goMall}}</view>
      <view
        wx:if="{{detail.canConfirmReceipt}}"
        class="action-chip action-chip-primary"
        bind:tap="onConfirmTap"
      >
        {{confirming ? texts.confirming : texts.confirmButton}}
      </view>
      <view
        wx:if="{{detail.hasReviewEntry}}"
        class="action-chip action-chip-primary"
        bind:tap="onReviewTap"
      >
        {{detail.hasReview ? texts.viewReviewButton : texts.reviewButton}}
      </view>
      <view
        wx:if="{{detail.hasAfterSalesEntry}}"
        class="action-chip action-chip-secondary"
        bind:tap="onAfterSalesTap"
      >
        {{detail.afterSalesApplication ? texts.afterSalesViewButton : texts.afterSalesButton}}
      </view>
    </view>
  </block>
</view>
