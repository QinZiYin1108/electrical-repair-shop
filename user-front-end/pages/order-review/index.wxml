<view class="review-page">
  <view wx:if="{{loading}}" class="state-card state-text">
    {{texts.loading}}
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-title">{{texts.loadFailed}}</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn retry-btn" bind:tap="onRetryTap">{{texts.retry}}</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="hero-card">
      <view class="hero-head">
        <view>
          <view class="hero-title">{{texts.title}}</view>
          <view class="hero-order">{{detail.orderNo}}</view>
        </view>
        <view class="hero-action" bind:tap="onViewOrderTap">{{texts.viewOrder}}</view>
      </view>
      <view class="hero-service">{{detail.serviceTitle}}</view>
      <view class="hero-status">{{detail.technicianName || '-'}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">订单信息</view>
      <view class="info-row">
        <text class="info-label">{{texts.orderNoLabel}}</text>
        <text class="info-value">{{detail.orderNo || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.serviceTitleLabel}}</text>
        <text class="info-value">{{detail.serviceTitle || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.technicianLabel}}</text>
        <text class="info-value">{{detail.technicianName || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.serviceModeLabel}}</text>
        <text class="info-value">{{detail.serviceModeText || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.completedLabel}}</text>
        <text class="info-value">{{detail.completionTimeText || '-'}}</text>
      </view>
    </view>

    <view wx:if="{{review}}" class="section-card">
      <view class="section-head">
        <view class="section-title">{{texts.historyTitle}}</view>
        <view class="status-badge">{{review.statusText || '-'}}</view>
      </view>
      <view class="stars-row">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star-icon {{item <= review.rating ? 'star-active' : ''}}"
        >★</text>
      </view>
      <view wx:if="{{review.content}}" class="review-content">{{review.content}}</view>
      <view class="review-meta">
        <text>{{review.createdTimeText}}</text>
        <text wx:if="{{review.isAnonymous}}">匿名评价</text>
      </view>
      <view wx:if="{{review.images.length}}" class="image-grid">
        <image
          wx:for="{{review.images}}"
          wx:key="id"
          class="image-item"
          src="{{item.thumbnailUrl}}"
          mode="aspectFill"
          data-current="{{item.url}}"
          bind:tap="onPreviewReviewImage"
        />
      </view>
      <view wx:if="{{review.replyContent}}" class="reply-card">
        <view class="reply-title">{{texts.replyTitle}}</view>
        <view class="reply-content">{{review.replyContent}}</view>
        <view wx:if="{{review.replyTimeText}}" class="reply-time">{{review.replyTimeText}}</view>
      </view>
    </view>

    <view wx:if="{{!review && detail.canReview}}" class="section-card form-card">
      <view class="section-title">{{texts.formTitle}}</view>

      <view class="field-title">{{texts.scoreTitle}}</view>
      <view class="stars-row">
        <text
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="star-icon {{item <= rating ? 'star-active' : ''}}"
          data-value="{{item}}"
          bind:tap="onChooseRating"
        >★</text>
      </view>

      <view class="field-title">{{texts.contentTitle}}</view>
      <textarea
        class="content-textarea"
        value="{{content}}"
        placeholder="{{texts.contentPlaceholder}}"
        maxlength="300"
        auto-height
        bindinput="onContentInput"
      />

      <view class="field-title">{{texts.imageTitle}}</view>
      <view class="field-tip">{{texts.imageTip}}</view>
      <view class="image-grid">
        <view wx:for="{{uploadImages}}" wx:key="id" class="upload-image-wrap">
          <image
            class="image-item"
            src="{{item.thumbnailUrl}}"
            mode="aspectFill"
            data-current="{{item.url}}"
            bind:tap="onPreviewUploadImage"
          />
          <view class="delete-tag" data-index="{{index}}" catch:tap="onDeleteImage">{{texts.deleteText}}</view>
        </view>
        <view wx:if="{{uploadImages.length < 5}}" class="upload-trigger" bind:tap="onChooseImages">
          <view class="upload-trigger-plus">+</view>
          <view class="upload-trigger-text">{{texts.addImage}}</view>
        </view>
      </view>

      <view class="switch-row" bind:tap="onToggleAnonymous">
        <view>
          <view class="switch-title">{{texts.anonymousLabel}}</view>
          <view class="switch-tip">{{texts.anonymousTip}}</view>
        </view>
        <view class="switch-pill {{isAnonymous ? 'switch-pill-active' : ''}}">
          <view class="switch-dot {{isAnonymous ? 'switch-dot-active' : ''}}"></view>
        </view>
      </view>

      <view class="primary-btn submit-btn" bind:tap="onSubmitTap">
        {{submitting ? texts.submitting : texts.submit}}
      </view>
    </view>

    <view wx:if="{{!review && !detail.canReview}}" class="section-card empty-card">
      <view class="empty-text">{{texts.noReviewTip}}</view>
    </view>
  </block>
</view>
