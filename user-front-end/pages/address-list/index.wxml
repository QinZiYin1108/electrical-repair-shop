<view class="page address-list-page">
  <view wx:if="{{addressList.length}}" class="address-list">
    <view
      wx:for="{{addressList}}"
      wx:key="id"
      class="address-card"
    >
      <view class="address-header">
        <view class="address-contact">
          <text class="name">{{item.contactName}}</text>
          <text class="phone">{{item.contactPhone}}</text>
        </view>
        <view class="address-tags">
          <van-tag
            wx:if="{{item.isDefault === 1}}"
            type="success"
            plain
            round
          >
            默认
          </van-tag>
          <van-tag plain round>{{item.addressTypeName || "其他"}}</van-tag>
        </view>
      </view>
      <view class="address-text">{{item.fullAddress || item.detail}}</view>
      <view class="address-actions">
        <van-button
          custom-class="address-action-btn"
          custom-style="min-width: 0; padding: 0 18rpx;"
          size="mini"
          plain
          type="primary"
          data-id="{{item.id}}"
          bind:tap="onEditAddress"
        >
          编辑
        </van-button>
        <van-button
          wx:if="{{item.isDefault !== 1}}"
          custom-class="address-action-btn"
          custom-style="min-width: 0; padding: 0 18rpx;"
          size="mini"
          plain
          data-id="{{item.id}}"
          bind:tap="onSetDefaultAddress"
        >
          设为默认
        </van-button>
        <van-button
          custom-class="address-action-btn"
          custom-style="min-width: 0; padding: 0 18rpx;"
          size="mini"
          plain
          type="danger"
          data-id="{{item.id}}"
          bind:tap="onDeleteAddress"
        >
          删除
        </van-button>
      </view>
    </view>
  </view>

  <view wx:else class="empty-wrap">
    <van-empty description="暂无地址，请先新增"></van-empty>
  </view>

  <view class="footer-actions">
    <van-button
      type="primary"
      round
      block
      loading="{{loading}}"
      bind:tap="onAddAddress"
    >
      新增地址
    </van-button>
  </view>
</view>
