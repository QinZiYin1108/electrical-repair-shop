<view class="page profile-page">
  <view class="profile-header">
    <view
      class="avatar-wrapper"
      bind:tap="onChangeAvatar"
    >
      <image
        wx:if="{{user.avatarUrl}}"
        class="avatar"
        src="{{user.avatarUrl}}"
        mode="aspectFill"
      />
      <view
        wx:else
        class="avatar avatar-placeholder"
      >
        {{user.username ? user.username.substring(0, 1) : "用"}}
      </view>
    </view>
    <view class="base-info">
      <view class="name">
        {{user.username || "未设置昵称"}}
      </view>
      <view class="sub">
        {{user.email || "未绑定邮箱"}}
      </view>
    </view>
  </view>

  <view class="profile-body">
    <view class="profile-actions">
      <van-button
        wx:if="{{!editMode}}"
        size="small"
        plain
        type="primary"
        bind:tap="onEditTap"
      >
        编辑
      </van-button>
      <van-button
        wx:if="{{editMode}}"
        size="small"
        type="primary"
        bind:tap="onSaveTap"
      >
        保存
      </van-button>
    </view>

    <view class="section-title">账号信息</view>
    <van-cell-group inset>
      <van-field
        label="账号ID"
        value="{{user.id}}"
        readonly
        border="{{true}}"
      />
      <van-field
        label="手机号"
        value="{{user.phone}}"
        placeholder="请输入手机号"
        readonly="{{!editMode}}"
        border="{{true}}"
        bind:change="onFieldChange"
        data-field="user.phone"
      />
      <van-field
        label="昵称"
        value="{{user.username}}"
        placeholder="请输入昵称"
        readonly="{{!editMode}}"
        border="{{false}}"
        bind:change="onFieldChange"
        data-field="user.username"
      />
    </van-cell-group>

    <view class="section-title">个人信息</view>
    <van-cell-group inset>
      <van-field
        label="真实姓名"
        value="{{profile.realName}}"
        placeholder="请输入真实姓名"
        readonly="{{!editMode}}"
        border="{{true}}"
        bind:change="onFieldChange"
        data-field="profile.realName"
      />
      <picker
        mode="selector"
        range="{{genderOptions}}"
        range-key="label"
        bindchange="onGenderPickerChange"
        disabled="{{!editMode}}"
      >
        <van-field
          label="性别"
          value="{{genderText}}"
          placeholder="请选择性别"
          readonly
          is-link="{{editMode}}"
          border="{{true}}"
        />
      </picker>
      <van-field
        label="职业"
        value="{{profile.profession}}"
        placeholder="请输入职业"
        readonly="{{!editMode}}"
        border="{{true}}"
        bind:change="onFieldChange"
        data-field="profile.profession"
      />
      <picker
        mode="date"
        value="{{profile.birthday}}"
        start="1900-01-01"
        end="{{today}}"
        bindchange="onBirthdayPickerChange"
        disabled="{{!editMode}}"
      >
        <van-field
          label="生日"
          value="{{profile.birthday}}"
          placeholder="请选择生日"
          readonly
          is-link="{{editMode}}"
          border="{{true}}"
        />
      </picker>
      <van-field
        label="紧急联系人"
        value="{{profile.emergencyContact}}"
        placeholder="请输入紧急联系人"
        readonly="{{!editMode}}"
        border="{{true}}"
        bind:change="onFieldChange"
        data-field="profile.emergencyContact"
      />
      <van-field
        label="紧急电话"
        value="{{profile.emergencyPhone}}"
        placeholder="请输入紧急联系电话"
        readonly="{{!editMode}}"
        border="{{false}}"
        bind:change="onFieldChange"
        data-field="profile.emergencyPhone"
      />
    </van-cell-group>
  </view>
</view>
