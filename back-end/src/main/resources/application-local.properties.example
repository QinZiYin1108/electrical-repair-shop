# ==========================================
# 本地开发环境 — 复制为 application-local.properties 后填写
# ==========================================

# ---- 数据库 ----
spring.datasource.url=jdbc:mysql://localhost:3306/electrical_repair_shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf-8
spring.datasource.username=root
spring.datasource.password=<your-db-password>
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5

# ---- Redis ----
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.database=0
spring.data.redis.password=

# ---- JWT ----
security.jwt.secret=<your-jwt-secret>
security.jwt.expire-seconds=2592000

# ---- 邮件 ----
spring.mail.username=<your-email@qq.com>
spring.mail.password=<your-smtp-auth-code>

# ---- 阿里云 OSS ----
aliyun.oss.endpoint=<your-oss-endpoint>
aliyun.oss.bucket-name=<your-bucket-name>
aliyun.oss.access-key-id=<your-access-key-id>
aliyun.oss.access-key-secret=<your-access-key-secret>

# ---- 微信小程序 ----
wx.mini.appid=<your-miniapp-appid>
wx.mini.secret=<your-miniapp-secret>

# ---- 百度地图 ----
baidu.map.ak=<your-baidu-map-ak>

# ---- 应用 ----
app.base-url=http://localhost:8080
app.door-qr.base-url=http://localhost:8080/api/pass/door-qr/scan

# ---- 日志 ----
logging.level.root=info
logging.level.com.example.backend=debug
logging.level.com.baomidou.mybatisplus=debug
