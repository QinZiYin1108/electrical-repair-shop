<view class="order-list-page">
  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-row">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{item.active ? 'tab-item-active' : ''}}"
        data-key="{{item.key}}"
        bind:tap="onTabTap"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="state-card state-text">
    {{texts.loading}}
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-title">{{texts.loadFailed}}</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="action-btn" bind:tap="onRetryTap">{{texts.retry}}</view>
  </view>

  <block wx:elif="{{orderList.length}}">
    <view wx:for="{{orderList}}" wx:key="id" class="order-card" data-id="{{item.id}}" bind:tap="onOrderTap">
      <view class="order-head">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>

      <view class="order-title">{{item.serviceTitle}}</view>
      <view wx:if="{{item.applianceText}}" class="order-appliance">{{item.applianceText}}</view>

      <view class="meta-row">
        <text class="meta-label">{{texts.addressLabel}}</text>
        <text class="meta-value">{{item.serviceAddress}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">{{texts.appointmentLabel}}</text>
        <text class="meta-value">{{item.appointmentText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">{{texts.technicianLabel}}</text>
        <text class="meta-value">{{item.technicianText}}</text>
      </view>
      <view wx:if="{{item.faultSummary}}" class="meta-row">
        <text class="meta-label">{{texts.faultLabel}}</text>
        <text class="meta-value">{{item.faultSummary}}</text>
      </view>

      <view class="order-foot">
        <view class="order-foot-main">
          <text class="order-amount">{{texts.priceLabel}} {{item.amountText}}</text>
          <text wx:if="{{item.paymentStatusText}}" class="order-payment">{{item.paymentStatusText}}</text>
        </view>
        <view class="order-foot-actions">
          <view
            wx:if="{{item.canConfirmCompletion}}"
            class="confirm-btn"
            data-id="{{item.id}}"
            catch:tap="onQuickConfirmCompletionTap"
          >
            {{texts.confirmCompletionButton}}
          </view>
          <view
            wx:if="{{item.canCancel}}"
            class="cancel-btn"
            data-id="{{item.id}}"
            catch:tap="onQuickCancelTap"
          >
            {{texts.cancelButton}}
          </view>
          <view
            wx:if="{{item.hasAfterSalesEntry}}"
            class="after-sales-btn"
            data-id="{{item.id}}"
            catch:tap="onQuickAfterSalesTap"
          >
            {{item.afterSalesButtonText}}
          </view>
          <view
            wx:if="{{item.canPayTail}}"
            class="pay-btn"
            data-id="{{item.id}}"
            catch:tap="onQuickPayTap"
          >
            {{texts.payButton}}
          </view>
          <view
            wx:if="{{item.hasDoorQr}}"
            class="door-qr-btn"
            data-id="{{item.id}}"
            data-order-no="{{item.orderNo}}"
            catch:tap="onDoorQrTap"
          >
            {{texts.doorQrButton}}
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="state-card">
    <view class="state-title">{{texts.emptyTitle}}</view>
    <view class="state-desc">{{texts.emptyDesc}}</view>
    <view class="action-btn" bind:tap="onCreateOrderTap">{{texts.createOrder}}</view>
  </view>

  <view wx:if="{{doorQrPopupVisible}}" class="door-qr-mask" catch:tap="onCloseDoorQrPopup">
    <view class="door-qr-popup" catch:tap="onPopupInnerTap">
      <view class="door-qr-title">{{texts.doorQrTitle}}</view>
      <view wx:if="{{doorQrPopupTitle}}" class="door-qr-order">{{doorQrPopupTitle}}</view>
      <view wx:if="{{doorQrPopupLoading}}" class="door-qr-loading">{{texts.doorQrLoading}}</view>
      <block wx:elif="{{doorQrData}}">
        <image wx:if="{{doorQrData.qrImageUrl}}" class="door-qr-image" src="{{doorQrData.qrImageUrl}}" mode="aspectFit" />
        <view class="door-qr-status">{{doorQrData.statusText}}</view>
        <view wx:if="{{doorQrData.expireTimeText}}" class="door-qr-expire">
          {{texts.doorQrExpireLabel}} {{doorQrData.expireTimeText}}
        </view>
      </block>
      <view class="door-qr-close" bind:tap="onCloseDoorQrPopup">{{texts.doorQrClose}}</view>
    </view>
  </view>
</view>
