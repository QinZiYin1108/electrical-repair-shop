@import "../order-flow/common.wxss";

.detail-page {
  padding-bottom: 220rpx;
}

.detail-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.detail-main {
  flex: 1;
}

.detail-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.detail-meta {
  display: block;
  margin: 8rpx 0 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.status-pill {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
  color: #475569;
  background: #f8fafc;
}

.status-success {
  color: #0b7f45;
  border-color: #b8e7cb;
  background: #e9f9f0;
}

.status-warning {
  color: #a15d00;
  border-color: #ffd89f;
  background: #fff4dd;
}

.status-primary {
  color: #0b59d8;
  border-color: #c6d9ff;
  background: #ecf2ff;
}

.action-btn-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #d8e3f0;
  background: #ffffff;
  color: #1677ff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.icon-btn-location {
  color: #0f766e;
  border-color: #b8ece0;
  background: #f0fdfa;
}

.icon-btn-follow {
  border-color: #1677ff;
}

.icon-btn-follow-active {
  background: #1677ff;
  color: #ffffff;
  border-color: #1677ff;
}

.detail-info {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.detail-label {
  color: #334155;
  font-size: 24rpx;
  min-width: 120rpx;
}

.detail-value {
  flex: 1;
  text-align: right;
  color: #0f172a;
  font-size: 24rpx;
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.review-card {
  margin-top: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fbff;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-user {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.review-stars {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.review-star {
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1;
}

.review-star-active {
  color: #f59e0b;
}

.review-time,
.review-empty,
.review-reply-time {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.review-content,
.review-reply-content {
  margin-top: 16rpx;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  background: #e2e8f0;
}

.review-reply {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
}

.review-reply-title {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 18rpx rgba(0, 0, 0, 0.06);
}

.footer-btn {
  flex: 1;
  height: 74rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  line-height: 48rpx;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  color: #334155;
}

.footer-btn::after {
  border: none;
}

.footer-btn-ghost {
  background: #ffffff;
  color: #334155;
}

.footer-btn-primary {
  border-color: #1677ff;
  background: #1677ff;
  color: #ffffff;
}
