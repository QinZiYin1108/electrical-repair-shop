<view class="page detail-page">
  <view wx:if="{{loading}}" class="section-card state-card">
    <text class="state-text">正在加载保修卡详情...</text>
  </view>
  <view wx:elif="{{loadError}}" class="section-card state-card">
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn" bind:tap="onRetryTap">重新加载</view>
  </view>
  <block wx:elif="{{detail}}">
    <view class="hero-card">
      <view class="hero-status">{{detail.warrantyStatusText}}</view>
      <view class="hero-title">{{detail.productName}}</view>
      <view class="hero-subtitle">{{detail.productModel}}</view>
    </view>
    <view class="section-card action-card">
      <view class="action-title">保修使用</view>
      <view class="action-desc">
        {{detail.canApplyUsage ? '提交保修申请后，管理员会尽快处理。' : (detail.pendingUsageCount ? '当前已有待处理申请，请等待管理员处理。' : '当前保修卡状态不可申请使用。')}}
      </view>
      <view class="primary-btn {{detail.canApplyUsage ? '' : 'primary-btn-disabled'}}" bind:tap="onApplyTap">
        {{detail.canApplyUsage ? '申请保修服务' : '暂不可申请'}}
      </view>
    </view>
    <view class="section-card">
      <view wx:for="{{infoRows}}" wx:key="label" class="info-row">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>
    <view class="section-card">
      <view class="usage-title">使用记录</view>
      <block wx:if="{{usageRecords.length}}">
        <view wx:for="{{usageRecords}}" wx:key="id" class="usage-item">
          <view class="usage-head">
            <text class="usage-status">{{item.statusText}}</text>
            <text class="usage-time">{{item.applyTimeText}}</text>
          </view>
          <view class="usage-row">故障描述：{{item.issueDescription}}</view>
          <view class="usage-row">联系人：{{item.contactName}} / {{item.contactPhone}}</view>
          <view class="usage-row">处理时间：{{item.processTimeText}}</view>
          <view wx:if="{{item.processRemark}}" class="usage-tip">处理备注：{{item.processRemark}}</view>
        </view>
      </block>
      <view wx:else class="empty-text">暂无保修使用记录</view>
    </view>
  </block>
</view>
