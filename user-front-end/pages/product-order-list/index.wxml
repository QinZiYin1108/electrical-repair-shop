<view class="page product-order-page">
  <view class="hero-section">
    <view class="hero-decoration hero-decoration-left"></view>
    <view class="hero-decoration hero-decoration-right"></view>
    <view class="hero-card">
      <view>
        <view class="hero-title">商城订单</view>
        <view class="hero-subtitle">查看商品订单、物流进度和确认收货</view>
      </view>
      <view class="hero-badge">{{orderList.length}} 单</view>
    </view>
  </view>

  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="false">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{item.active ? 'tab-item-active' : ''}}"
        data-key="{{item.key}}"
        bind:tap="onTabTap"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="section-card state-card">
    <text class="state-text">{{texts.loading}}</text>
  </view>

  <view wx:elif="{{loadError}}" class="section-card state-card">
    <view class="state-title">{{texts.loadFailed}}</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn" bind:tap="onRetryTap">{{texts.retry}}</view>
  </view>

  <block wx:elif="{{orderList.length}}">
    <view wx:for="{{orderList}}" wx:key="id" class="section-card order-card">
      <view class="order-top">
        <view>
          <view class="order-no">订单号 {{item.orderNo}}</view>
          <view class="order-sub">{{item.createdTimeText}}</view>
        </view>
        <view class="order-status">{{item.statusText}}</view>
      </view>

      <view class="goods-row" data-id="{{item.id}}" bind:tap="onOrderTap">
        <view class="goods-media">
          <image wx:if="{{item.firstProductImage}}" class="goods-image" src="{{item.firstProductImage}}" mode="aspectFill" />
          <view wx:else class="goods-image-empty">暂无图片</view>
        </view>
        <view class="goods-main">
          <text class="goods-name">{{item.productSummary}}</text>
          <text class="goods-meta">共 {{item.itemCount}} 件 / {{item.deliveryStatusText}}</text>
          <text class="goods-meta">{{item.deliveryTimeText}}</text>
          <text wx:if="{{item.afterSalesApplication}}" class="goods-meta goods-meta-accent">
            售后：{{item.afterSalesApplication.statusText}}
          </text>
        </view>
        <view class="goods-price">￥{{item.actualAmountText}}</view>
      </view>

      <view class="order-bottom">
        <view class="order-total">
          <text class="order-total-label">订单合计</text>
          <text class="order-total-value">￥{{item.totalAmountText}}</text>
        </view>
        <view class="action-row">
          <view
            wx:if="{{item.canConfirmReceipt}}"
            class="action-chip action-chip-primary"
            data-id="{{item.id}}"
            bind:tap="onConfirmTap"
          >
            {{confirmingOrderId === item.id ? texts.confirming : texts.confirmButton}}
          </view>
          <view
            wx:if="{{item.canReview || item.hasReview}}"
            class="action-chip action-chip-primary"
            data-id="{{item.id}}"
            bind:tap="onReviewTap"
          >
            {{item.hasReview ? texts.viewReviewButton : texts.reviewButton}}
          </view>
          <view
            wx:if="{{item.hasAfterSalesEntry}}"
            class="action-chip action-chip-secondary"
            data-id="{{item.id}}"
            bind:tap="onAfterSalesTap"
          >
            {{item.afterSalesApplication ? texts.afterSalesViewButton : texts.afterSalesButton}}
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="section-card state-card empty-card">
    <view class="state-title">{{texts.emptyTitle}}</view>
    <view class="state-desc">{{texts.emptyDesc}}</view>
    <view class="primary-btn" bind:tap="onGoMallTap">{{texts.goMall}}</view>
  </view>
</view>
