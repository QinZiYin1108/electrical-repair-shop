@import "../common.wxss";

.field-wrap {
  margin-top: 10rpx;
}

.field-item + .field-item {
  margin-top: 10rpx;
}

.field-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: #4b5563;
}

.field-input {
  height: 72rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  font-size: 24rpx;
  background-color: #f9fafb;
  color: #111827;
  display: flex;
  align-items: center;
}

.picker-input {
  color: #374151;
}

.fault-list {
  margin-top: 10rpx;
}

.fault-item {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 14rpx;
}

.fault-item + .fault-item {
  margin-top: 12rpx;
}

.fault-name {
  display: block;
  font-size: 25rpx;
  color: #111827;
  font-weight: 600;
}

.fault-textarea {
  margin-top: 8rpx;
  width: 100%;
  min-height: 110rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d1d5db;
  background-color: #f9fafb;
  box-sizing: border-box;
  padding: 12rpx;
  font-size: 24rpx;
  color: #1f2937;
}

.media-title {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #4b5563;
}

.media-row {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -6rpx 0;
}

.media-thumb,
.media-add {
  margin: 6rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.media-thumb {
  border: 1rpx solid #d1d5db;
  background-color: #f8fafc;
}

.media-image {
  width: 100%;
  height: 100%;
}

.media-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.media-add {
  border: 1rpx dashed #9abdf6;
  background-color: #edf4ff;
}

.media-add-plus {
  font-size: 42rpx;
  line-height: 1;
  color: #1677ff;
}

.media-add-text {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #1677ff;
}

.media-add-video {
  margin-top: 8rpx;
  width: 100%;
  height: 88rpx;
  flex-direction: row;
  border-radius: 12rpx;
}

.media-add-video .media-add-plus {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.media-add-video .media-add-text {
  margin-top: 0;
}

.video-preview-wrap {
  margin-top: 8rpx;
}

.video-preview {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  background: #0f172a;
}

.video-action-row {
  margin-top: 10rpx;
  display: flex;
  gap: 10rpx;
}

.video-action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  border: 1rpx solid #9abdf6;
  background: #edf4ff;
  color: #1677ff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-action-btn-danger {
  border-color: #fecaca;
  background: #fff1f2;
  color: #dc2626;
}
