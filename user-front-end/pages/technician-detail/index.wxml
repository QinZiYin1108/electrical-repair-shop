<view class="flow-page detail-page">
  <view class="flow-header">
    <text class="flow-step">{{labels.step}}</text>
    <text class="flow-title">{{labels.title}}</text>
    <text class="flow-sub">{{detail ? detail.name : ''}}</text>
  </view>

  <view class="section-card" wx:if="{{detail}}">
    <view class="detail-top">
      <view class="detail-avatar">
        <image wx:if="{{detail.avatarUrl}}" class="avatar-img" src="{{detail.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback">{{detail.name ? detail.name.substring(0, 1) : labels.defaultInitial}}</view>
      </view>
      <view class="detail-main">
        <text class="detail-name">{{detail.name}}</text>
        <text class="detail-meta">{{labels.rating}} {{detail.rating}} | {{labels.orderCount}} {{detail.orderCount}}</text>
        <text class="status-pill status-{{detail.workStatusType}}">{{detail.workStatusText}}</text>
      </view>
      <view class="action-btn-group">
        <view class="icon-btn icon-btn-location" bind:tap="onOpenLocation">
          <van-icon name="location-o" size="24" />
        </view>
        <view class="icon-btn icon-btn-follow {{detail.isFollowed ? 'icon-btn-follow-active' : ''}}" bind:tap="onToggleFollow">
          <van-icon name="{{detail.isFollowed ? 'star' : 'star-o'}}" size="24" />
        </view>
      </view>
    </view>

    <view class="detail-info">
      <text class="detail-label">{{labels.workYears}}</text>
      <text class="detail-value">{{detail.workYears != null ? detail.workYears + labels.yearSuffix : "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.completedOrderCount}}</text>
      <text class="detail-value">{{detail.completedOrderCount != null ? detail.completedOrderCount + labels.completedOrderSuffix: "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.specialties}}</text>
      <text class="detail-value">{{detail.specialties || "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.certificates}}</text>
      <text class="detail-value">{{detail.certificates || "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.education}}</text>
      <text class="detail-value">{{detail.education || "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.location}}</text>
      <text class="detail-value">{{detail.locationAddress || "-"}}</text>
    </view>
    <view class="detail-info">
      <text class="detail-label">{{labels.intro}}</text>
      <text class="detail-value">{{detail.introduction || "-"}}</text>
    </view>
  </view>

  <view class="section-card" wx:if="{{detail}}">
    <view class="section-title">{{labels.reviewTitle}}</view>
    <block wx:if="{{detail.reviews && detail.reviews.length}}">
      <view wx:for="{{detail.reviews}}" wx:key="id" wx:for-index="reviewIndex" class="review-card">
        <view class="review-head">
          <view>
            <text class="review-user">{{item.userDisplayName}}</text>
            <view class="review-stars">
              <text
                wx:for="{{item.stars}}"
                wx:key="value"
                wx:for-item="star"
                class="review-star {{star.active ? 'review-star-active' : ''}}"
              >★</text>
            </view>
          </view>
          <text class="review-time">{{item.createdTimeText}}</text>
        </view>
        <view wx:if="{{item.content}}" class="review-content">{{item.content}}</view>
        <view wx:if="{{item.images.length}}" class="review-images">
          <image
            wx:for="{{item.images}}"
            wx:key="id"
            wx:for-item="imageItem"
            class="review-image"
            src="{{imageItem.thumbnailUrl}}"
            mode="aspectFill"
            data-review-index="{{reviewIndex}}"
            data-current="{{imageItem.url}}"
            bind:tap="onPreviewReviewImage"
          />
        </view>
        <view wx:if="{{item.replyContent}}" class="review-reply">
          <text class="review-reply-title">{{labels.replyTitle}}</text>
          <text class="review-reply-content">{{item.replyContent}}</text>
          <text wx:if="{{item.replyTimeText}}" class="review-reply-time">{{item.replyTimeText}}</text>
        </view>
      </view>
    </block>
    <view wx:else class="review-empty">{{labels.reviewEmpty}}</view>
  </view>
</view>
