.page {
  min-height: 100vh;
  padding: 0 24rpx 292rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.hero-section {
  position: relative;
  margin: 0 -24rpx;
  padding: 28rpx 24rpx 0;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 24rpx;
  left: 18rpx;
  width: 168rpx;
  height: 168rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-decoration-right {
  top: 92rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.12);
}

.hero-card,
.section-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.hero-count {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
}

.loading-card,
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
}

.loading-text,
.empty-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-btn {
  width: 240rpx;
  height: 82rpx;
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.summary-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.summary-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ef4444;
}

.cart-list-card {
  padding-top: 4rpx;
  padding-bottom: 8rpx;
}

.cart-item {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  padding: 20rpx 0;
}

.cart-item + .cart-item {
  border-top: 1rpx solid #eef2f7;
}

.check-wrap {
  width: 42rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.check-icon-active {
  border-color: #1677ff;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
}

.check-icon-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.cart-main {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 18rpx;
}

.cart-media {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
}

.cart-image,
.cart-image-empty {
  width: 100%;
  height: 100%;
}

.cart-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.cart-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cart-name {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1f2937;
}

.cart-meta,
.cart-path,
.cart-stock-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.cart-stock-tip {
  color: #ef4444;
}

.cart-foot {
  margin-top: auto;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.price-wrap {
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.cart-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ef4444;
}

.cart-original-price {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.quantity-control {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.05);
}

.quantity-btn-disabled {
  color: #cbd5e1;
}

.quantity-value {
  min-width: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
}

.cart-bottom-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.line-amount {
  font-size: 22rpx;
  color: #475569;
}

.delete-link {
  font-size: 22rpx;
  color: #ef4444;
}

.submit-bar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 100rpx;
  z-index: 10;
}

.submit-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 2rpx solid #dbe6f3;
  box-shadow: 0 -12rpx 28rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.submit-check {
  width: 96rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.submit-check-text {
  font-size: 20rpx;
  color: #64748b;
}

.submit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.submit-total-label,
.submit-total-sub {
  font-size: 20rpx;
  color: #64748b;
}

.submit-total-value {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ef4444;
}

.submit-total-sub {
  margin-top: 4rpx;
}

.submit-btn {
  width: 220rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8847 0%, #ff5a36 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn-disabled {
  opacity: 0.45;
}
