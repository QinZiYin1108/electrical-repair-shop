.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.settings-body {
  margin-top: 12rpx;
}

.brand-about-card {
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f5fbff 100%);
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.brand-about-logo {
  width: 260rpx;
  display: block;
}

.brand-about-title {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #12355b;
}

.brand-about-copy {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4b5563;
}

.brand-about-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.brand-about-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background-color: #eaf3ff;
  font-size: 20rpx;
  color: #1677ff;
}
