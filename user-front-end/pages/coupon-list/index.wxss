.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.hero-card,
.section-card {
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #fff;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

.hero-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.tab-scroll {
  margin-top: 20rpx;
}

.tab-list {
  display: flex;
  gap: 16rpx;
}

.tab-item {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #64748b;
}

.tab-item-active {
  background: #1677ff;
  color: #fff;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff;
}

.state-card {
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.state-text,
.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  text-align: center;
}

.primary-btn {
  margin-top: 20rpx;
  width: 220rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.coupon-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.coupon-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.coupon-type {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.coupon-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  font-size: 22rpx;
  color: #1677ff;
}

.coupon-discount {
  margin-top: 20rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #ef4444;
}

.coupon-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.7;
}

.coupon-tip {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  line-height: 1.7;
}
