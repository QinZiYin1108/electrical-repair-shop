<view class="page cart-page">
  <view class="hero-section">
    <view class="hero-decoration hero-decoration-left"></view>
    <view class="hero-decoration hero-decoration-right"></view>
    <view class="hero-card">
      <view>
        <view class="hero-title">购物车</view>
        <view class="hero-subtitle">常用商品先放这里，确认后再统一结算更方便</view>
      </view>
      <view class="hero-count">{{totalCount}} 件商品</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section-card loading-card">
    <van-loading size="24px" color="#1677ff" />
    <text class="loading-text">购物车加载中...</text>
  </view>

  <block wx:elif="{{items.length}}">
    <view class="section-card summary-card">
      <view class="summary-top">
        <view>
          <text class="section-title">待结算商品</text>
          <text class="summary-sub">已选 {{selectedCount}} 件，支持批量删除和统一结算</text>
        </view>
        <text class="summary-action" bind:tap="onDeleteSelected">删除已选</text>
      </view>
    </view>

    <view class="section-card cart-list-card">
      <view
        wx:for="{{items}}"
        wx:key="cartId"
        class="cart-item"
      >
        <view class="check-wrap" data-id="{{item.cartId}}" data-selected="{{item.selected ? 1 : 0}}" bind:tap="onToggleItem">
          <view class="check-icon {{item.selected ? 'check-icon-active' : ''}}">
            <text wx:if="{{item.selected}}" class="check-icon-text">✓</text>
          </view>
        </view>

        <view class="cart-main" data-id="{{item.productId}}" bind:tap="onProductTap">
          <view class="cart-media">
            <image wx:if="{{item.mainImageUrl}}" class="cart-image" src="{{item.mainImageUrl}}" mode="aspectFill" />
            <view wx:else class="cart-image-empty">暂无图片</view>
          </view>

          <view class="cart-body">
            <text class="cart-name">{{item.name}}</text>
            <text class="cart-meta">{{item.brand || '品牌待补充'}}{{item.model ? ' / ' + item.model : ''}}</text>
            <text wx:if="{{item.categoryPath}}" class="cart-path">{{item.categoryPath}}</text>
            <text wx:if="{{item.stockTip}}" class="cart-stock-tip">{{item.stockTip}}</text>

            <view class="cart-foot">
              <view class="price-wrap">
                <text class="cart-price">￥{{item.sellingPriceText}}</text>
                <text wx:if="{{item.showOriginalPrice}}" class="cart-original-price">￥{{item.originalPriceText}}</text>
              </view>

              <view catchtap="noop" class="quantity-control">
                <view
                  class="quantity-btn {{item.quantity <= 1 ? 'quantity-btn-disabled' : ''}}"
                  data-id="{{item.cartId}}"
                  data-type="decrease"
                  data-quantity="{{item.quantity}}"
                  data-stock="{{item.stockQuantity}}"
                  bind:tap="onQuantityStepTap"
                >-</view>
                <text class="quantity-value">{{item.quantity}}</text>
                <view
                  class="quantity-btn {{item.stockQuantity > 0 && item.quantity >= item.stockQuantity ? 'quantity-btn-disabled' : ''}}"
                  data-id="{{item.cartId}}"
                  data-type="increase"
                  data-quantity="{{item.quantity}}"
                  data-stock="{{item.stockQuantity}}"
                  bind:tap="onQuantityStepTap"
                >+</view>
              </view>
            </view>

            <view class="cart-bottom-row">
              <text class="line-amount">小计 ￥{{item.lineAmountText}}</text>
              <text class="delete-link" data-id="{{item.cartId}}" catch:tap="onDeleteItem">移除</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="section-card empty-card">
    <view class="empty-title">购物车还是空的</view>
    <view class="empty-desc">先去商城挑几件商品，加入购物车后就可以统一结算</view>
    <view class="empty-btn" bind:tap="onGoMallTap">去逛商城</view>
  </view>

  <view wx:if="{{items.length}}" class="submit-bar-shell">
    <view class="submit-bar">
      <view class="submit-check" bind:tap="onToggleAll">
        <view class="check-icon {{allSelected ? 'check-icon-active' : ''}}">
          <text wx:if="{{allSelected}}" class="check-icon-text">✓</text>
        </view>
        <text class="submit-check-text">全选</text>
      </view>

      <view class="submit-main">
        <text class="submit-total-label">合计</text>
        <text class="submit-total-value">￥{{selectedAmountText}}</text>
        <text class="submit-total-sub">已选 {{selectedCount}} 件</text>
      </view>

      <view class="submit-btn {{selectedCount ? '' : 'submit-btn-disabled'}}" bind:tap="onCheckoutTap">
        去结算
      </view>
    </view>
  </view>
</view>
