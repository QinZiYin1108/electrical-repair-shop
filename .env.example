# ==========================================
# 速修派 — 环境变量配置
# 复制为 .env，填入实际值
# 本机和服务器都使用 SPRING_PROFILES_ACTIVE=prod
# ==========================================

# ---- 服务器 ----
SERVER_PORT=8081

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/electrical_repair_shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf-8
DB_USERNAME=root
DB_PASSWORD=root
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONNECTION_TIMEOUT=30000

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_SECONDS=2592000

# ---- 邮件 ----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your_email@qq.com
MAIL_PASSWORD=your_smtp_password

# ---- 阿里云 OSS ----
ALIYUN_OSS_ENDPOINT=oss-cn-xxx.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=your-bucket
ALIYUN_OSS_ACCESS_KEY_ID=your_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_access_key_secret

# ---- 阿里云 AI 安全护栏（内容安全）----
# 如果和 OSS 使用同一组访问密钥，可以保持为空并使用后端默认回退。
ALIYUN_GREEN_ACCESS_KEY_ID=
ALIYUN_GREEN_ACCESS_KEY_SECRET=
ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com

# ---- 微信小程序 ----
WX_MINI_APPID=your_wx_appid
WX_MINI_SECRET=your_wx_secret

# ---- 微信支付 API v3（完成商户验收前保持 false） ----
WX_PAY_ENABLED=false
WX_PAY_APPID=your_wx_appid
WX_PAY_MCH_ID=your_wechat_pay_merchant_id
WX_PAY_MERCHANT_SERIAL_NUMBER=your_merchant_certificate_serial_number
WX_PAY_PRIVATE_KEY_PATH=absolute_path_to_apiclient_key.pem
WX_PAY_API_V3_KEY=your_32_character_api_v3_key
WX_PAY_NOTIFY_URL=https://example.com/api/pass/payments/wechat/notify
WX_PAY_REFUND_NOTIFY_URL=https://example.com/api/pass/payments/wechat/refund-notify

# ---- 腾讯云 SMS / FaceID ----
TENCENT_SMS_SECRET_ID=your_tencent_secret_id
TENCENT_SMS_SECRET_KEY=your_tencent_secret_key
TENCENT_SMS_SDK_APP_ID=your_sms_sdk_app_id
TENCENT_SMS_SIGN_NAME=your_sms_sign_name
TENCENT_SMS_LOGIN_TEMPLATE_ID=your_login_template_id
TENCENT_SMS_RESET_PASSWORD_TEMPLATE_ID=your_reset_password_template_id
TENCENT_SMS_CHANGE_PHONE_TEMPLATE_ID=your_change_phone_template_id

# ---- 腾讯地图 ----
TENCENT_MAP_KEY=your_tencent_map_key

# ---- 应用 ----
APP_BASE_URL=http://localhost:8081
APP_DOOR_QR_BASE_URL=http://localhost:8081/api/pass/door-qr/scan

# ---- 日志 ----
LOG_LEVEL_ROOT=info
LOG_LEVEL_BACKEND=debug
LOG_LEVEL_MYBATIS=debug
