<view class="page category-detail-page">
  <view wx:if="{{loading}}" class="loading-card">
    <text class="loading-text">分类详情加载中...</text>
  </view>

  <block wx:elif="{{categoryDetail}}">
    <view class="detail-card">
      <view class="detail-top">
        <view class="detail-icon-wrap">
          <image
            wx:if="{{categoryDetail.iconUrl}}"
            class="detail-icon-image"
            src="{{categoryDetail.iconUrl}}"
            mode="aspectFill"
          />
          <view wx:else class="detail-icon-text">{{categoryDetail.name ? categoryDetail.name.substring(0, 1) : "修"}}</view>
        </view>
        <view class="detail-main">
          <text class="detail-name">{{categoryDetail.name}}</text>
        </view>
      </view>

      <view class="info-list">
        <view class="info-item">
          <text class="info-label">分类编码</text>
          <text class="info-value">{{categoryDetail.code || "-"}}</text>
        </view>
        <view class="info-item info-item-column">
          <text class="info-label">分类描述</text>
          <text class="info-value info-value-block">{{categoryDetail.description || "暂无分类描述"}}</text>
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">服务类型类型</text>
      <view class="mode-list">
        <view
          wx:for="{{serviceModes}}"
          wx:key="id"
          class="mode-item {{selectedServiceMode === item.id ? 'mode-item-active' : ''}}"
          data-mode="{{item.id}}"
          bind:tap="onSelectServiceMode"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <view class="section-card">
      <text class="section-title">服务类型</text>
      <view wx:if="{{serviceTypeOptions.length}}" class="service-type-list">
        <view
          wx:for="{{serviceTypeOptions}}"
          wx:key="id"
          class="service-type-item {{selectedServiceTypeId === item.id ? 'service-type-item-active' : ''}}"
          data-id="{{item.id}}"
          bind:tap="onSelectServiceType"
        >
          <view class="service-type-head">
            <text class="service-type-name">{{item.name}}</text>
            <text class="service-type-tag">{{item.typeTagText}}</text>
          </view>
          <text class="service-type-price">基础费用 {{item.basePrice}} 元起</text>
        </view>
      </view>
      <van-empty wx:else description="当前分类下暂无该服务方式的服务类型" />
    </view>
  </block>
</view>

<view wx:if="{{!loading && categoryDetail}}" class="bottom-bar">
  <van-button type="primary" round block bind:tap="onPlaceOrder">选择后下单</van-button>
</view>
