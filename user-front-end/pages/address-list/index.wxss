.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.address-list {
  padding-bottom: 140rpx;
}

.address-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.address-card + .address-card {
  margin-top: 20rpx;
}

.address-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.address-contact {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #323233;
}

.phone {
  font-size: 26rpx;
  color: #646566;
}

.address-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.address-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #323233;
}

.address-actions {
  margin-top: 16rpx;
  margin-left: -12rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.address-action-btn {
  margin-top: 12rpx;
  margin-left: 12rpx;
  max-width: 100%;
}

.empty-wrap {
  margin-top: 120rpx;
}

.footer-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}
