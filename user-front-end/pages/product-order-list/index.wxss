.page {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.hero-section {
  position: relative;
  margin: 0 -24rpx;
  padding: 28rpx 24rpx 0;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 24rpx;
  left: 18rpx;
  width: 168rpx;
  height: 168rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-decoration-right {
  top: 92rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.12);
}

.hero-card,
.section-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.hero-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.tab-scroll {
  margin: 20rpx -24rpx 0;
  white-space: nowrap;
}

.tab-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.tab-item {
  min-width: 144rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-item-active {
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.22);
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
}

.state-card,
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 280rpx;
}

.state-text,
.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.order-card {
  padding-bottom: 22rpx;
}

.order-top,
.order-bottom,
.action-row,
.order-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-no {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2937;
}

.order-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.order-status {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  color: #1677ff;
  font-size: 22rpx;
}

.goods-row {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #f9fbff 0%, #f8fafc 100%);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.goods-media {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eff6ff;
}

.goods-image,
.goods-image-empty {
  width: 100%;
  height: 100%;
}

.goods-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.goods-meta,
.order-total-label {
  font-size: 22rpx;
  color: #64748b;
}

.goods-meta-accent {
  color: #0f766e;
  font-weight: 600;
}

.goods-price,
.order-total-value {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
}

.order-bottom {
  margin-top: 20rpx;
  align-items: flex-end;
}

.action-row {
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.primary-btn,
.ghost-btn {
  min-width: 176rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  margin-top: 26rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
}

.ghost-btn {
  background: #f3f6fb;
  color: #475569;
}

.action-chip {
  min-width: 132rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.action-chip-secondary {
  border: 1rpx solid #d8e2ee;
  background: #f8fafc;
  color: #475569;
}

.action-chip-primary {
  border: 1rpx solid #1677ff;
  background: #1677ff;
  color: #ffffff;
}
