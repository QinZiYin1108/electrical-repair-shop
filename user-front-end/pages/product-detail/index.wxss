.page {
  min-height: 100vh;
  padding: 0 0 186rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #edf5ff 0%, #f6f8fc 180rpx, #ffffff 420rpx, #ffffff 100%);
}

.hero-section {
  position: relative;
  padding-top: 16rpx;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 26rpx;
  left: 18rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-decoration-right {
  top: 100rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.14);
}

.loading-shell,
.detail-shell {
  position: relative;
  z-index: 1;
  background: transparent;
}

.loading-shell {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.media-stage {
  position: relative;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
}

.media-swiper,
.media-image,
.media-video,
.media-empty {
  width: 100%;
  height: 620rpx;
}

.media-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.media-video {
  background: #000000;
}

.media-badge-row {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.media-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #ffffff;
}

.badge-recommend {
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
}

.badge-hot {
  background: linear-gradient(135deg, #fb7185 0%, #f97316 100%);
}

.badge-new {
  background: linear-gradient(135deg, #22c55e 0%, #14b8a6 100%);
}

.media-index {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(15, 23, 42, 0.4);
}

.summary-section {
  padding: 22rpx 24rpx 14rpx;
  background: #ffffff;
}

.price-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.price-current {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  color: #ef4444;
}

.price-original {
  font-size: 24rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.title-row {
  margin-top: 12rpx;
}

.product-title {
  font-size: 34rpx;
  line-height: 1.42;
  font-weight: 700;
  color: #111827;
}

.meta-row {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #475569;
}

.meta-text-light,
.meta-dot {
  color: #94a3b8;
}

.price-tip {
  display: block;
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #4b6b8f;
}

.mini-meta-row {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.mini-meta-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f8fc;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.mini-meta-label {
  font-size: 20rpx;
  line-height: 1;
  color: #64748b;
}

.mini-meta-value {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
  color: #1f2937;
}

.entry-section {
  padding: 0 24rpx;
  background: #ffffff;
}

.entry-row {
  min-height: 104rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.entry-row-last {
  padding-bottom: 22rpx;
}

.entry-main {
  flex: 1;
  min-width: 0;
}

.entry-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.entry-preview {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.entry-preview-address {
  max-height: 70rpx;
  overflow: hidden;
}

.entry-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #94a3b8;
}

.review-preview-section {
  padding: 8rpx 24rpx 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #eef2f7;
}

.review-preview-head {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.review-preview-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.review-preview-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.review-preview-count {
  font-size: 24rpx;
  color: #64748b;
}

.review-preview-link {
  font-size: 22rpx;
  color: #94a3b8;
}

.review-preview-item {
  padding: 18rpx 0 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.review-preview-user-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.review-preview-user-main {
  flex: 1;
  min-width: 0;
}

.review-preview-user {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
}

.review-preview-stars {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.review-preview-meta-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.review-preview-star {
  font-size: 24rpx;
  line-height: 1;
  color: #cbd5e1;
}

.review-preview-star-active {
  color: #f59e0b;
}

.review-preview-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.review-preview-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #fff5ea;
  font-size: 20rpx;
  line-height: 1;
  color: #f97316;
}

.review-preview-time {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #94a3b8;
}

.review-preview-content {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #334155;
  white-space: pre-wrap;
  word-break: break-word;
}

.review-preview-images {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
}

.review-preview-image {
  width: 136rpx;
  height: 136rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
}

.review-preview-empty {
  padding: 10rpx 0 4rpx;
  font-size: 24rpx;
  color: #64748b;
}

.bottom-bar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.bottom-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.99);
  border-top: 2rpx solid #dbe6f3;
  box-shadow: 0 -12rpx 28rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.favorite-action {
  width: 108rpx;
  flex-shrink: 0;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.favorite-action-text {
  font-size: 20rpx;
  line-height: 1;
  color: #64748b;
}

.action-pill {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: stretch;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(251, 146, 60, 0.18);
}

.action-pill-btn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.action-pill-cart {
  background: linear-gradient(135deg, #ffd768 0%, #ffb524 100%);
}

.action-pill-buy {
  background: linear-gradient(135deg, #ff8847 0%, #ff5a36 100%);
}

.sheet-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.sheet-handle {
  width: 84rpx;
  height: 8rpx;
  margin: 18rpx auto 0;
  border-radius: 999rpx;
  background: #dbe6f3;
}

.sheet-header {
  padding: 18rpx 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #edf2f7;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.sheet-close {
  font-size: 24rpx;
  color: #1677ff;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx 42rpx;
  box-sizing: border-box;
}

.sheet-scroll-address {
  padding-bottom: 28rpx;
}

.sheet-section {
  padding-top: 8rpx;
}

.sheet-highlight {
  display: block;
  padding: 18rpx 0 22rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #35526f;
  white-space: pre-wrap;
  border-bottom: 1rpx solid #edf2f7;
}

.sheet-item {
  padding: 20rpx 0;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.sheet-item:last-child {
  border-bottom: none;
}

.sheet-item-label {
  width: 176rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.sheet-item-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: right;
  color: #111827;
  word-break: break-all;
}

.sheet-empty {
  padding: 80rpx 24rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.sheet-empty-text {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
}

.address-section {
  padding-top: 6rpx;
}

.address-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.address-item-selected {
  background: linear-gradient(90deg, rgba(22, 119, 255, 0.05) 0%, rgba(22, 119, 255, 0) 100%);
}

.address-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.address-person {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.address-phone {
  font-size: 24rpx;
  color: #475569;
}

.address-tag {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #1677ff;
  background: #edf4ff;
}

.address-meta {
  margin-top: 12rpx;
}

.address-type {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1;
  color: #4b6b8f;
  background: #f3f7fc;
}

.address-detail {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #334155;
}

.sheet-footer {
  padding: 18rpx 24rpx 30rpx;
  background: #ffffff;
  border-top: 1rpx solid #edf2f7;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.sheet-footer-btn {
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.sheet-footer-ghost {
  color: #1677ff;
  background: #edf4ff;
}

.sheet-footer-primary {
  color: #ffffff;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(22, 119, 255, 0.18);
}

.review-section {
  padding-top: 0;
}

.review-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.review-item:last-child {
  border-bottom: none;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.review-user-block {
  flex: 1;
  min-width: 0;
}

.review-user {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.review-stars {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.review-meta-row {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.review-star {
  font-size: 28rpx;
  line-height: 1;
  color: #cbd5e1;
}

.review-star-active {
  color: #f59e0b;
}

.review-score {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.review-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.review-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #fff5ea;
  font-size: 20rpx;
  line-height: 1;
  color: #f97316;
}

.review-time,
.review-reply-time {
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.review-content,
.review-reply-content {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: #334155;
  white-space: pre-wrap;
  word-break: break-word;
}

.review-images {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.review-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
}

.review-reply {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #f8fbff;
  border-radius: 18rpx;
}

.review-reply-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1677ff;
}
