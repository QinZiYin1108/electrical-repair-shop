# ==========================================
# 后端生产环境变量（systemd EnvironmentFile）
# 对应 back-end/src/main/resources/application-prod.properties 的占位符
# 用法：复制到 /opt/electrical-repair-shop/.env 并填写真实值
# ==========================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# ---- 数据库（Oracle MySQL 8.4 LTS）----
# 建议为应用单独建库用户（见 deploy/README.md 第 4 步）；root 默认走 auth_socket
DB_URL=jdbc:mysql://127.0.0.1:3306/electrical_repair_shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf-8
DB_USERNAME=app
DB_PASSWORD=change-me

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE_SECONDS=2592000

# ---- 邮件（固定 SMTP）----
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your@qq.com
MAIL_PASSWORD=your-smtp-auth-code

# ---- 阿里云 OSS ----
ALIYUN_OSS_ENDPOINT=oss-cn-xxx.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=your-bucket
ALIYUN_OSS_ACCESS_KEY_ID=your-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-key-secret

# ---- 阿里云内容安全（默认复用 OSS 的 key；可单独覆盖）----
# ALIYUN_GREEN_ACCESS_KEY_ID=
# ALIYUN_GREEN_ACCESS_KEY_SECRET=
# ALIYUN_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com

# ---- 微信小程序 ----
WX_MINI_APPID=wx0000000000000000
WX_MINI_SECRET=your-miniapp-secret

# ---- 微信支付 API v3（联调真实商户时启用）----
# 注意：必须填写各值后再将 WX_PAY_ENABLED 置 true；密钥文件用服务器绝对路径
WX_PAY_ENABLED=false
WX_PAY_APPID=wx0000000000000000
WX_PAY_MCH_ID=your-merchant-id
WX_PAY_MERCHANT_SERIAL_NUMBER=your-cert-serial-number
WX_PAY_PRIVATE_KEY_PATH=/opt/electrical-repair-shop/certs/apiclient_key.pem
WX_PAY_API_V3_KEY=your-32-char-api-v3-key
# 新商户必须配「微信支付公钥」（微信已不再下发平台证书）：
#   商户平台 → API 安全 → 微信支付公钥 → 申请并下载 pub_key.pem，并记下「公钥ID」
WX_PAY_PUBLIC_KEY_ID=PUB_KEY_ID_0000000000000000000000000000000000
WX_PAY_PUBLIC_KEY_PATH=/opt/electrical-repair-shop/certs/wechatpay_pub_key.pem
WX_PAY_NOTIFY_URL=https://api.thdqwx.work/api/pass/payments/wechat/notify
WX_PAY_REFUND_NOTIFY_URL=https://api.thdqwx.work/api/pass/payments/wechat/refund-notify

# ---- 腾讯云 SMS ----
TENCENT_SMS_SECRET_ID=your-tencent-secret-id
TENCENT_SMS_SECRET_KEY=your-tencent-secret-key
TENCENT_SMS_SDK_APP_ID=your-sms-sdk-app-id
TENCENT_SMS_SIGN_NAME=your-sign-name
TENCENT_SMS_LOGIN_TEMPLATE_ID=your-login-template-id
TENCENT_SMS_RESET_PASSWORD_TEMPLATE_ID=your-reset-password-template-id
TENCENT_SMS_CHANGE_PHONE_TEMPLATE_ID=your-change-phone-template-id

# ---- 腾讯地图 ----
TENCENT_MAP_KEY=your-tencent-map-key

# ---- 应用 ----
APP_BASE_URL=https://api.thdqwx.work
CORS_ALLOWED_ORIGINS=https://admin.thdqwx.work,https://www.thdqwx.work

# ---- 数据库迁移（启用前先备份）----
FLYWAY_ENABLED=false

# ---- 内容审核失败策略 ----
CONTENT_CHECK_FAILURE_POLICY=quarantine

# ---- 后台前端构建期 API 基址（build-deploy.sh 使用）----
ADMIN_API_BASE_URL=https://api.thdqwx.work/api
