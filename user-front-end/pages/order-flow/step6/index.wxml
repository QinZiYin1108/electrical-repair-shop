<view class="flow-page" style="padding-bottom: {{contentPaddingBottomPx}}px;">
  <view class="flow-header">
    <text class="flow-step">步骤 6 / 6</text>
    <text class="flow-title">确认并提交订单</text>
    <text class="flow-sub">{{serviceModeName}} | {{serviceTypeName}}</text>
  </view>

  <view class="section-card">
    <text class="section-title">订单摘要</text>
    <view class="row"><text>分类</text><text>{{categoryPath}}</text></view>
    <view class="row"><text>师傅</text><text>{{technicianName}}</text></view>
    <view class="row"><text>地址</text><text>{{addressText}}</text></view>
    <view class="row"><text>预约</text><text>{{appointmentText}}</text></view>
  </view>

  <view class="section-card">
    <text class="section-title">设备信息</text>
    <view class="row"><text>品牌</text><text>{{applianceBrand}}</text></view>
    <view class="row"><text>型号</text><text>{{applianceModel}}</text></view>
    <view class="row"><text>购买日期</text><text>{{purchaseDate}}</text></view>
  </view>

  <view class="section-card">
    <text class="section-title">故障信息（按故障现象）</text>
    <view wx:if="{{faultSummaryList.length}}" class="fault-summary-list">
      <view wx:for="{{faultSummaryList}}" wx:key="id" class="fault-summary-item">
        <text class="fault-summary-name">{{item.name}}</text>
        <text class="fault-summary-desc">{{item.description || '未填写描述'}}</text>
        <text class="fault-summary-media">图片 {{item.imageCount}} 张，视频 {{item.hasVideo ? '1 个' : '0 个'}}</text>
      </view>
    </view>
    <view wx:else class="empty-tip">当前没有故障明细（上门安装或用户跳过）</view>
  </view>

  <view class="section-card" wx:if="{{feePreview}}">
    <text class="section-title">上门费用预览</text>
    <view class="row"><text>上门费</text><text>¥{{feePreview.doorFee}}</text></view>
    <view class="row"><text>距离费</text><text>¥{{feePreview.distanceFee}}</text></view>
    <view class="row row-total"><text>预付合计</text><text>¥{{feePreview.totalAmount}}</text></view>
    <text class="sub-text">{{feePreview.formula}}</text>
  </view>

  <view class="section-card" wx:if="{{feePreview && serviceMode !== 3}}">
    <text class="section-title">支付方式</text>
    <view class="pay-tip">下单前需先支付上门服务费，请选择支付方式。</view>

    <view
      class="pay-method-item {{selectedPaymentMethod === 5 ? 'pay-method-item--active' : ''}}"
      data-method="5"
      bind:tap="onSelectPaymentMethod"
    >
      <view class="pay-method-main">
        <text class="pay-method-name">钱包支付</text>
        <text class="pay-method-desc">当前余额 ¥{{walletBalanceText}}</text>
      </view>
      <view class="pay-method-check {{selectedPaymentMethod === 5 ? 'pay-method-check--active' : ''}}"></view>
    </view>

    <view
      class="pay-method-item {{selectedPaymentMethod === 1 ? 'pay-method-item--active' : ''}}"
      data-method="1"
      bind:tap="onSelectPaymentMethod"
    >
      <view class="pay-method-main">
        <text class="pay-method-name">微信支付</text>
      </view>
      <view class="pay-method-check {{selectedPaymentMethod === 1 ? 'pay-method-check--active' : ''}}"></view>
    </view>

    <view
      class="pay-method-item {{selectedPaymentMethod === 2 ? 'pay-method-item--active' : ''}}"
      data-method="2"
      bind:tap="onSelectPaymentMethod"
    >
      <view class="pay-method-main">
        <text class="pay-method-name">支付宝支付</text>
      </view>
      <view class="pay-method-check {{selectedPaymentMethod === 2 ? 'pay-method-check--active' : ''}}"></view>
    </view>
  </view>
</view>

<view id="submitFooter" class="submit-footer">
  <view class="submit-amount">
    <text class="submit-label">{{submitAmountLabel}}</text>
    <text class="submit-value">{{submitAmountText}}</text>
  </view>
  <view class="submit-actions">
    <van-button plain round bind:tap="onPrev">上一步</van-button>
    <van-button type="primary" round bind:tap="onSubmit">{{submitButtonText}}</van-button>
  </view>
  <van-button custom-class="restart-btn" plain round bind:tap="onRestart">重新开始流程</van-button>
</view>
