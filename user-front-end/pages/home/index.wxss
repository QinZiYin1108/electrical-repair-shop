.home-scroll {
  height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 28%, #f5f6f8 100%);
}

.home-page {
  padding: 20rpx 24rpx 140rpx;
  box-sizing: border-box;
}

.hero-section {
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 26rpx rgba(23, 46, 86, 0.08);
}

.banner-swipe {
  height: 250rpx;
}

.banner-item {
  position: relative;
  overflow: hidden;
  height: 250rpx;
  padding: 30rpx 28rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.banner-bg-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(140deg, rgba(16, 39, 78, 0.46) 0%, rgba(16, 39, 78, 0.18) 100%);
}

.banner-content {
  position: relative;
  z-index: 1;
}

.banner-content-image-only {
  padding-top: 6rpx;
}

.banner-theme-0 {
  background: linear-gradient(120deg, #1677ff 0%, #36cfc9 100%);
}

.banner-theme-1 {
  background: linear-gradient(120deg, #4f46e5 0%, #38bdf8 100%);
}

.banner-theme-2 {
  background: linear-gradient(120deg, #0f766e 0%, #65a30d 100%);
}

.banner-tag {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background-color: rgba(255, 255, 255, 0.22);
}

.banner-title {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
}

.banner-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.notice-wrap {
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.brand-strip {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f4fbff 100%);
}

.brand-strip-logo {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.brand-strip-main {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}

.brand-strip-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #12355b;
}

.brand-strip-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5f7b99;
}

.section-card {
  margin-top: 20rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.04);
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.section-link {
  font-size: 24rpx;
  color: #1677ff;
}

.primary-entry {
  margin-top: 24rpx;
}

.main-order-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  background: linear-gradient(120deg, #edf4ff 0%, #f3fffb 100%);
}

.main-order-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #12355b;
  line-height: 1.2;
}

.main-order-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #4b6b8f;
}

.quick-grid {
  margin-top: 12rpx;
}

.order-summary-row {
  display: flex;
}

.order-summary-item {
  flex: 1;
  min-width: 0;
  background-color: #f7f9fc;
  border-radius: 14rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}

.order-summary-item + .order-summary-item {
  margin-left: 10rpx;
}

.order-count {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.order-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.latest-order-card {
  margin-top: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 14rpx;
}

.latest-order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.latest-order-no {
  font-size: 24rpx;
  color: #334155;
}

.latest-order-status {
  font-size: 24rpx;
  color: #1677ff;
  font-weight: 500;
}

.latest-order-appliance {
  display: block;
  margin: 8rpx 0 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.empty-latest-order {
  margin-top: 16rpx;
  border: 1rpx dashed #d8dee9;
  border-radius: 14rpx;
  padding: 20rpx 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.login-tip-text {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.worker-scroll {
  white-space: nowrap;
}

.empty-followed-workers {
  font-size: 24rpx;
  color: #64748b;
  padding: 14rpx 8rpx;
}

.worker-list {
  display: inline-flex;
}

.worker-card {
  width: 246rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: linear-gradient(150deg, #fbfcfe 0%, #f4f7fb 100%);
  border: 1rpx solid #edf2f7;
  margin-right: 14rpx;
}

.worker-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.worker-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #dbeafe;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.worker-avatar-image {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f1f5f9;
}

.worker-name {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.worker-skill,
.worker-score {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
}

.category-item + .category-item {
  margin-top: 10rpx;
}

.category-item:active {
  background-color: #f8fafc;
}

.category-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  background-color: #e9f2ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon-image {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
}

.category-icon-empty {
  font-size: 18rpx;
  color: #94a3b8;
}

.category-main {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
}

.category-name {
  display: block;
  font-size: 27rpx;
  color: #1f2937;
  font-weight: 500;
}

.category-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.empty-hot-categories {
  font-size: 24rpx;
  color: #64748b;
  padding: 14rpx 8rpx;
}

.product-showcase-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.product-showcase-head {
  align-items: flex-start;
}

.showcase-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.featured-product {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #edf4ff 0%, #f3fffb 100%);
}

.featured-product-main {
  flex: 1;
  min-width: 0;
}

.featured-product-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.featured-product-badge {
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: #1677ff;
}

.featured-product-badge-light {
  color: #1677ff;
  background: rgba(255, 255, 255, 0.82);
}

.featured-product-name {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.34;
  font-weight: 700;
  color: #12355b;
}

.featured-product-meta,
.featured-product-path {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #4b6b8f;
}

.featured-product-price-row {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
}

.featured-product-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #ef4444;
}

.featured-product-original {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.featured-product-foot {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.featured-product-foot-text {
  font-size: 22rpx;
  color: #64748b;
}

.featured-product-media {
  width: 190rpx;
  height: 190rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.75);
}

.featured-product-image,
.featured-product-image-empty {
  width: 100%;
  height: 100%;
}

.featured-product-image-empty,
.secondary-product-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.secondary-product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.secondary-product-card {
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #edf2f7;
}

.secondary-product-media {
  height: 168rpx;
  background: #f8fafc;
}

.secondary-product-image,
.secondary-product-image-empty {
  width: 100%;
  height: 100%;
}

.secondary-product-body {
  padding: 16rpx;
}

.secondary-product-name {
  display: block;
  min-height: 68rpx;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #1f2937;
}

.secondary-product-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.secondary-product-foot {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.secondary-product-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ef4444;
}

.secondary-product-sales {
  font-size: 20rpx;
  color: #94a3b8;
}

.mall-login-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.mall-login-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.smart-entry-list {
  display: flex;
  flex-direction: column;
}

.smart-entry-item {
  display: flex;
  align-items: center;
  border-radius: 14rpx;
  padding: 14rpx 12rpx;
  background-color: #f8fafc;
}

.smart-entry-item + .smart-entry-item {
  margin-top: 10rpx;
}

.smart-entry-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 10rpx;
  background-color: #e6ffed;
  display: flex;
  align-items: center;
  justify-content: center;
}

.smart-entry-main {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.smart-entry-title {
  display: block;
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 500;
}

.smart-entry-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
