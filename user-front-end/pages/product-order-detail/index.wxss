.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 220rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.hero-card,
.section-card,
.action-bar {
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
}

.hero-head,
.section-head,
.info-row,
.goods-item,
.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-status {
  font-size: 32rpx;
  font-weight: 700;
}

.hero-sub,
.hero-no {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-title {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
}

.hero-amount {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.copy-link {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.info-row {
  padding: 18rpx 0;
  align-items: flex-start;
}

.info-row + .info-row,
.goods-item + .goods-item {
  border-top: 1rpx solid #eef2f7;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #1f2937;
  line-height: 1.7;
  text-align: right;
  word-break: break-word;
}

.info-value-strong {
  font-size: 28rpx;
  font-weight: 700;
  color: #ef4444;
}

.goods-item {
  padding: 22rpx 0;
}

.goods-media {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eff6ff;
}

.goods-image,
.goods-image-empty {
  width: 100%;
  height: 100%;
}

.goods-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.5;
}

.goods-meta {
  font-size: 22rpx;
  color: #64748b;
}

.goods-total {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #ef4444;
}

.state-card {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-text,
.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  text-align: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.bottom-space {
  height: 12rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 2rpx solid #dbe6f3;
  z-index: 10;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.primary-btn,
.ghost-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
}

.ghost-btn {
  background: #f3f6fb;
  color: #475569;
}

.action-chip {
  min-width: 152rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.action-chip-secondary {
  border: 1rpx solid #d8e2ee;
  background: #f8fafc;
  color: #475569;
}

.action-chip-primary {
  border: 1rpx solid #1677ff;
  background: #1677ff;
  color: #ffffff;
}
