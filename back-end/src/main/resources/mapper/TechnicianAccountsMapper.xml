<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.backend.mapper.TechnicianAccountsMapper">

    <resultMap id="BaseResultMap" type="com.example.backend.entity.TechnicianAccounts">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="phone" column="phone" />
            <result property="email" column="email" />
            <result property="wechatOpenid" column="wechat_openid" />
            <result property="wechatUnionid" column="wechat_unionid" />
            <result property="passwordHash" column="password_hash" />
            <result property="salt" column="salt" />
            <result property="accountStatus" column="account_status" />
            <result property="lastLoginTime" column="last_login_time" />
            <result property="lastLoginIp" column="last_login_ip" />
            <result property="workStatus" column="work_status" />
            <result property="rating" column="rating" />
            <result property="orderCount" column="order_count" />
            <result property="completionRate" column="completion_rate" />
            <result property="createdTime" column="created_time" />
            <result property="updatedTime" column="updated_time" />
            <result property="version" column="version" />
            <result property="isDelete" column="is_delete" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,phone,email,wechat_openid,wechat_unionid,
        password_hash,salt,account_status,last_login_time,last_login_ip,
        work_status,rating,order_count,completion_rate,created_time,updated_time,
        version,is_delete
    </sql>

    <select id="selectByEmailIncludeDeleted" resultMap="BaseResultMap">
        SELECT
            id,
            username,
            phone,
            email,
            wechat_openid,
            wechat_unionid,
            password_hash,
            salt,
            account_status,
            last_login_time,
            last_login_ip,
            work_status,
            rating,
            order_count,
            completion_rate,
            created_time,
            updated_time,
            version,
            is_delete
        FROM technician_accounts
        WHERE email = #{email}
        LIMIT 1
    </select>
</mapper>
