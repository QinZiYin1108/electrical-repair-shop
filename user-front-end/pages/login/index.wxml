<view class="login-page">
  <view class="top-area">
    <view class="time-text">{{timeText}}</view>
    <view class="welcome-text">欢迎使用，安心修到家</view>
    <view class="top-wave"></view>
  </view>

  <view class="middle-area">
    <view class="login-card">
      <view class="login-mode-switch">
        <view
          class="login-mode-item {{loginMode === 'wechat' ? 'login-mode-item-active' : ''}}"
          data-mode="wechat"
          bindtap="onModeTap"
        >
          微信登录
        </view>
        <view
          class="login-mode-item {{loginMode === 'password' ? 'login-mode-item-active' : ''}}"
          data-mode="password"
          bindtap="onModeTap"
        >
          手机号密码登录
        </view>
      </view>

      <view wx:if="{{loginMode === 'password'}}" class="login-fields">
        <view class="login-field-shell">
          <van-field
            value="{{phone}}"
            data-field="phone"
            label="手机号"
            placeholder="请输入手机号"
            clearable
            border="{{false}}"
            bind:change="onFieldChange"
          />
        </view>
        <view class="login-field-shell">
          <van-field
            value="{{password}}"
            data-field="password"
            label="密码"
            type="password"
            placeholder="请输入密码"
            clearable
            border="{{false}}"
            bind:change="onFieldChange"
          />
        </view>
        <view class="login-mode-tip">请使用已绑定手机号且已设置密码的账号登录</view>
      </view>

      <button
        class="primary-login-btn {{agreed ? '' : 'primary-login-btn-disabled'}} {{loginMode === 'password' ? 'primary-login-btn-password' : 'primary-login-btn-wechat'}}"
        bindtap="onLoginTap"
        hover-class="btn-hover"
        loading="{{loginSubmitting}}"
      >
        <view class="btn-content">
          <view wx:if="{{loginMode === 'wechat'}}" class="btn-icon">
            <van-icon name="wechat" />
          </view>
          <text>{{loginMode === 'wechat' ? '微信一键登录' : '手机号密码登录'}}</text>
        </view>
      </button>
    </view>

  <!-- 邮箱绑定弹窗 -->
  <view class="bind-mask" wx:if="{{showBindEmail}}" catchtouchmove="noop">
    <view class="bind-modal">
      <view class="bind-modal-title">绑定邮箱</view>
      <view class="bind-modal-desc">为了保障账号安全，请先绑定邮箱</view>

      <view class="bind-field">
        <input
          class="bind-input"
          type="text"
          placeholder="请输入邮箱"
          value="{{bindEmail}}"
          bindinput="onBindEmailInput"
          maxlength="100"
        />
      </view>

      <view class="bind-code-row">
        <input
          class="bind-input bind-code-input"
          type="text"
          placeholder="验证码"
          value="{{bindCode}}"
          bindinput="onBindCodeInput"
          maxlength="6"
        />
        <button
          class="bind-code-btn {{bindCountdown > 0 || bindSending ? 'bind-code-btn-disabled' : ''}}"
          size="mini"
          bindtap="onBindSendCode"
          disabled="{{bindSending || bindCountdown > 0}}"
        >
          {{bindCountdown > 0 ? bindCountdown + 's' : (bindSending ? '发送中' : '获取验证码')}}
        </button>
      </view>

      <button
        class="bind-submit-btn"
        bindtap="onBindSubmit"
        loading="{{bindSubmitting}}"
        disabled="{{bindSubmitting}}"
      >
        确认绑定
      </button>
    </view>
  </view>

  <!-- 手机号绑定弹窗 -->
  <view class="bind-mask" wx:if="{{showBindPhone}}" catchtouchmove="noop">
    <view class="bind-modal">
      <view class="bind-modal-title">绑定手机号</view>
      <view class="bind-modal-desc">为了保障账号安全，请先绑定手机号</view>

      <view class="bind-field">
        <input
          class="bind-input"
          type="text"
          placeholder="请输入手机号"
          value="{{bindPhone}}"
          bindinput="onBindPhoneInput"
          maxlength="11"
        />
      </view>

      <view class="bind-code-row">
        <input
          class="bind-input bind-code-input"
          type="text"
          placeholder="验证码"
          value="{{bindCode}}"
          bindinput="onBindCodeInput"
          maxlength="6"
        />
        <button
          class="bind-code-btn {{bindCountdown > 0 || bindSending ? 'bind-code-btn-disabled' : ''}}"
          size="mini"
          bindtap="onBindSendCode"
          disabled="{{bindSending || bindCountdown > 0}}"
        >
          {{bindCountdown > 0 ? bindCountdown + 's' : (bindSending ? '发送中' : '获取验证码')}}
        </button>
      </view>

      <button
        class="bind-submit-btn"
        bindtap="onBindSubmit"
        loading="{{bindSubmitting}}"
        disabled="{{bindSubmitting}}"
      >
        确认绑定
      </button>
    </view>
  </view>

    <view class="agreement-row" bindtap="onToggleAgree">
      <view class="checkbox {{agreed ? 'checkbox-checked' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <view class="agreement-text-container">
        <text class="agreement-text">我已阅读并同意</text>
        <text class="agreement-link" catchtap="onProtocolTap" data-type="user">《用户协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" catchtap="onProtocolTap" data-type="privacy">《隐私协议》</text>
      </view>
    </view>
  </view>
</view>
