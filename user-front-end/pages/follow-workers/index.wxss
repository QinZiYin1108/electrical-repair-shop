.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 28%, #f5f6f8 100%);
}

.hero-card,
.loading-card,
.tech-card,
.empty-wrap {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.04);
}

.hero-card {
  padding: 28rpx 24rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.hero-address {
  margin-top: 18rpx;
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f1ff;
  color: #1677ff;
  font-size: 22rpx;
}

.tech-list {
  margin-top: 20rpx;
}

.loading-card {
  margin-top: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
}

.loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.tech-card {
  padding: 22rpx 20rpx;
}

.tech-card + .tech-card {
  margin-top: 16rpx;
}

.tech-top {
  display: flex;
  align-items: center;
}

.tech-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #dbeafe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 30rpx;
  color: #1d4ed8;
  font-weight: 600;
}

.tech-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.tech-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tech-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.distance-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff7db;
  color: #9a6700;
  font-size: 21rpx;
}

.tech-meta {
  margin: 10rpx 0;
  font-size: 23rpx;
  color: #64748b;
}

.tech-meta-item {
  margin-right: 14rpx;
}

.status-pill {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
  color: #475569;
  background: #f8fafc;
}

.status-success {
  color: #0b7f45;
  border-color: #b8e7cb;
  background: #e9f9f0;
}

.status-warning {
  color: #a15d00;
  border-color: #ffd89f;
  background: #fff4dd;
}

.status-primary {
  color: #0b59d8;
  border-color: #c6d9ff;
  background: #ecf2ff;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-tip {
  font-size: 22rpx;
  color: #64748b;
}

.footer-link {
  font-size: 24rpx;
  color: #1677ff;
}

.empty-wrap {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}
