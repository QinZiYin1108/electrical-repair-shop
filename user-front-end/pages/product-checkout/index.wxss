.page {
  min-height: 100vh;
  padding: 0 24rpx 230rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.loading-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.hero-section {
  position: relative;
  margin: 0 -24rpx;
  padding: 28rpx 24rpx 0;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 24rpx;
  left: 18rpx;
  width: 164rpx;
  height: 164rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-decoration-right {
  top: 92rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.12);
}

.hero-card,
.section-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.hero-badge {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.section-link,
.section-sub {
  font-size: 22rpx;
  color: #64748b;
}

.address-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.address-top-row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.address-phone {
  font-size: 24rpx;
  color: #475569;
}

.address-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #edf4ff;
  font-size: 20rpx;
  color: #1677ff;
}

.address-detail,
.address-empty {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.goods-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
}

.goods-item + .goods-item {
  border-top: 1rpx solid #eef2f7;
}

.goods-media {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
}

.goods-image,
.goods-image-empty {
  width: 100%;
  height: 100%;
}

.goods-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.goods-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  color: #1f2937;
}

.goods-spec,
.goods-subtotal {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.goods-price-row {
  margin-top: auto;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ef4444;
}

.goods-quantity {
  font-size: 24rpx;
  color: #475569;
}

.quantity-control {
  flex-shrink: 0;
  height: 60rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.quantity-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.05);
}

.quantity-btn-disabled {
  color: #cbd5e1;
}

.quantity-value {
  min-width: 34rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2937;
  text-align: center;
}

.coupon-card {
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.coupon-summary {
  margin-top: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #fffdf8 100%);
  border: 1rpx solid #fed7aa;
}

.coupon-summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.coupon-summary-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.coupon-summary-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #ea580c;
}

.coupon-summary-meta,
.coupon-empty {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.remark-input {
  width: 100%;
  min-height: 110rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #1f2937;
  line-height: 1.7;
}

.payment-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e6edf6;
  background: linear-gradient(180deg, #fbfdff 0%, #f8fbff 100%);
}

.payment-item-active {
  border-color: #bfdbfe;
  box-shadow: inset 0 0 0 1rpx rgba(22, 119, 255, 0.14);
}

.payment-item-wallet.payment-item-active {
  background: linear-gradient(180deg, #eef6ff 0%, #f4fbff 100%);
}

.payment-item-wechat.payment-item-active {
  background: linear-gradient(180deg, #f0fff8 0%, #f7fffb 100%);
}

.payment-item-alipay.payment-item-active {
  background: linear-gradient(180deg, #eef8ff 0%, #f7fbff 100%);
}

.payment-radio {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #ffffff;
}

.payment-radio-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: transparent;
}

.payment-radio-dot-active {
  background: #1677ff;
}

.payment-main {
  flex: 1;
  min-width: 0;
}

.payment-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.payment-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.payment-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 20rpx;
}

.payment-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.amount-row + .amount-row {
  margin-top: 16rpx;
}

.amount-label {
  font-size: 26rpx;
  color: #1f2937;
}

.amount-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #ef4444;
}

.amount-value-discount {
  color: #ea580c;
}

.amount-row-final {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eef2f7;
}

.amount-label-final {
  font-weight: 600;
}

.amount-row-tip {
  margin-top: 12rpx;
  justify-content: flex-start;
}

.amount-tip {
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.submit-bar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.submit-bar {
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 2rpx solid #dbe6f3;
  box-shadow: 0 -12rpx 28rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.submit-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.submit-label {
  font-size: 20rpx;
  color: #64748b;
}

.submit-value {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ef4444;
}

.submit-btn {
  width: 236rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff8847 0%, #ff5a36 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.sheet-handle {
  width: 84rpx;
  height: 8rpx;
  margin: 18rpx auto 12rpx;
  border-radius: 999rpx;
  background: #dbe6f3;
}

.sheet-header {
  padding: 0 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.sheet-close {
  font-size: 24rpx;
  color: #1677ff;
}

.sheet-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.sheet-empty {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.sheet-empty-text {
  font-size: 24rpx;
  color: #64748b;
}

.sheet-address-item {
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  border: 1rpx solid transparent;
}

.sheet-address-item + .sheet-address-item {
  margin-top: 16rpx;
}

.sheet-address-item-active {
  background: #edf4ff;
  border-color: #bfdbfe;
}

.sheet-address-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.sheet-address-person {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.sheet-address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.sheet-address-phone,
.sheet-address-type,
.sheet-address-detail {
  font-size: 22rpx;
  color: #64748b;
}

.sheet-address-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.12);
  color: #1677ff;
  font-size: 20rpx;
}

.sheet-address-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.sheet-address-type {
  flex-shrink: 0;
}

.sheet-address-detail {
  flex: 1;
  min-width: 0;
  line-height: 1.7;
}

.sheet-coupon-item {
  margin-bottom: 16rpx;
}

.sheet-coupon-item-disabled {
  opacity: 0.62;
}

.sheet-coupon-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-coupon-discount {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sheet-coupon-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #ea580c;
}

.sheet-coupon-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.sheet-coupon-tip {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  line-height: 1.7;
}

.sheet-footer {
  padding: 20rpx 24rpx 156rpx;
  border-top: 1rpx solid #edf2f7;
  display: flex;
  gap: 16rpx;
  background: #ffffff;
}

.sheet-footer-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sheet-footer-ghost {
  background: #f3f6fb;
  color: #475569;
}

.sheet-footer-primary {
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
}
