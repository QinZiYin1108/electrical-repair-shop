.store-detail-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.loading-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* Section card */
.section-card {
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
}

/* Store header */
.store-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.store-logo-wrap {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
}

.store-logo {
  width: 100%;
  height: 100%;
}

.store-logo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.store-logo-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 700;
}

.store-info {
  flex: 1;
  min-width: 0;
}

.store-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.store-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

/* Rating chip */
.rating-chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.chip-rated {
  background: #fff7e6;
  color: #d46b08;
}

.chip-unrated {
  background: #f1f5f9;
  color: #64748b;
}

.rating-star {
  font-size: 22rpx;
}

.rating-text {
  font-weight: 600;
}

.rating-count {
  font-size: 22rpx;
  opacity: 0.8;
}

/* Status chip */
.status-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.chip-open {
  background: #f0fdf4;
  color: #16a34a;
}

.chip-closed {
  background: #fef2f2;
  color: #dc2626;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.status-text {
  font-weight: 500;
}

.store-address-row {
  margin-top: 8rpx;
}

.store-address {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

/* Business hours */
.hours-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hours-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.hours-row:last-child {
  border-bottom: none;
}

.hours-day {
  width: 80rpx;
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

.hours-time {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.hours-rest {
  opacity: 0.5;
}

.hours-rest-text {
  flex: 1;
  font-size: 26rpx;
  color: #94a3b8;
}

/* Store description */
.store-desc {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.7;
}

/* Product grid */
.products-loading {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.product-media {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background: #f8fafc;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-image-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #cbd5e1;
}

.badge-list {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  display: flex;
  gap: 4rpx;
}

.product-badge {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.badge-hot {
  background: #ff4d4f;
  color: #fff;
}

.badge-new {
  background: #1677ff;
  color: #fff;
}

.product-body {
  padding: 16rpx;
}

.product-name {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-bottom: 4rpx;
}

.price-current {
  font-size: 28rpx;
  font-weight: 700;
  color: #e8431a;
}

.price-original {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.product-sales {
  font-size: 22rpx;
  color: #94a3b8;
}

/* Empty state */
.empty-products {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}
