<view class="page settings-page">
  <view class="settings-body">
    <van-cell-group inset>
      <van-cell
        title="个人资料"
        value="查看和管理个人信息"
        is-link
        bind:tap="onNavigateProfile"
      />
    </van-cell-group>

    <van-cell-group inset>
      <van-cell
        title="注销账号"
        value="{{cancelCellValue}}"
        is-link
        bind:tap="onAccountCancelTap"
      />
    </van-cell-group>

    <van-cell-group inset>
      <van-cell
        title="退出登录"
        is-link
        bind:tap="onLogoutTap"
      />
    </van-cell-group>
  </view>
</view>
