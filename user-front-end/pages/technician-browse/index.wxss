@import "../order-flow/common.wxss";

.browse-page {
  padding-bottom: 220rpx;
}

.tech-list {
  margin-top: 6rpx;
}

.tech-card {
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 16rpx;
  background: #ffffff;
}

.tech-card + .tech-card {
  margin-top: 14rpx;
}

.tech-card-active {
  border-color: #1677ff;
  box-shadow: 0 8rpx 18rpx rgba(22, 119, 255, 0.12);
}

.tech-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tech-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  font-size: 28rpx;
  color: #1e293b;
  font-weight: 600;
}

.tech-main {
  flex: 1;
}

.tech-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tech-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.mini-badge {
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
}

.badge-selected {
  color: #0b7f45;
  background: #ddf8e6;
}

.badge-recommend {
  color: #0b59d8;
  background: #e8f0ff;
}

.tech-meta {
  margin: 6rpx 0 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tech-meta-item {
  margin-right: 12rpx;
}

.status-pill {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d1d5db;
  color: #475569;
  background: #f8fafc;
}

.status-success {
  color: #0b7f45;
  border-color: #b8e7cb;
  background: #e9f9f0;
}

.status-warning {
  color: #a15d00;
  border-color: #ffd89f;
  background: #fff4dd;
}

.status-primary {
  color: #0b59d8;
  border-color: #c6d9ff;
  background: #ecf2ff;
}

.icon-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.icon-btn {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #f1f5f9;
  border: 1rpx solid #dbe2ea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn-active {
  background: #fff7db;
  border-color: #ffd777;
}

.icon-symbol {
  font-size: 28rpx;
  line-height: 1;
  color: #334155;
}

.tap-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #64748b;
}

.browse-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 18rpx rgba(0, 0, 0, 0.06);
}

.footer-btn {
  flex: 1;
  height: 74rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  line-height: 48rpx;
  border: 1rpx solid #d1d5db;
  background: #ffffff;
  color: #334155;
}

.footer-btn::after {
  border: none;
}

.footer-btn-ghost {
  background: #ffffff;
  color: #334155;
}

.footer-btn-primary {
  border-color: #1677ff;
  background: #1677ff;
  color: #ffffff;
}
