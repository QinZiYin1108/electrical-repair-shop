<view class="flow-page">
  <view class="flow-header">
    <text class="flow-step">步骤 4 / 6</text>
    <text class="flow-title">故障信息</text>
    <text class="flow-sub">{{serviceModeName}} | {{serviceTypeName}}</text>
  </view>

  <view class="section-card">
    <text class="section-title">基础信息（可选）</text>
    <view class="field-wrap">
      <view class="field-item">
        <text class="field-label">电器品牌</text>
        <input class="field-input" value="{{applianceBrand}}" placeholder="例如：海尔 / 美的" bindinput="onBrandInput" />
      </view>
      <view class="field-item">
        <text class="field-label">电器型号</text>
        <input class="field-input" value="{{applianceModel}}" placeholder="例如：KFR-35GW" bindinput="onModelInput" />
      </view>
      <view class="field-item">
        <text class="field-label">购买日期</text>
        <picker mode="date" value="{{purchaseDate}}" bindchange="onPurchaseDateChange">
          <view class="field-input picker-input">{{purchaseDate || '请选择（可不填）'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="section-card">
    <text class="section-title">故障现象（可多选）</text>
    <view class="chip-list">
      <view
        wx:for="{{faultOptions}}"
        wx:key="id"
        class="chip {{item.selected ? 'chip-active' : ''}}"
        data-id="{{item.id}}"
        bind:tap="onToggleFault"
      >
        {{item.name}}
      </view>
    </view>
    <text class="sub-text">每个故障现象都可单独填写描述并上传 3 图 + 1 视频</text>
  </view>

  <view class="section-card" wx:if="{{selectedFaultDetailList.length}}">
    <text class="section-title">故障详情填写</text>
    <view class="fault-list">
      <view wx:for="{{selectedFaultDetailList}}" wx:key="id" wx:for-item="fault" class="fault-item">
        <text class="fault-name">{{fault.name}}</text>
        <textarea
          class="fault-textarea"
          auto-height
          maxlength="300"
          placeholder="输入该故障的详细描述（可不填）"
          value="{{fault.description}}"
          data-faultid="{{fault.id}}"
          bindinput="onFaultDescInput"
        />

        <view class="media-title">图片（{{fault.images.length}} / 3）</view>
        <view class="media-row">
          <view
            wx:for="{{fault.images}}"
            wx:key="id"
            wx:for-item="img"
            class="media-thumb"
            data-faultid="{{fault.id}}"
            data-index="{{index}}"
            bind:tap="onPreviewFaultImage"
          >
            <image class="media-image" src="{{img.url || img.localPath}}" mode="aspectFill" />
            <view class="media-remove" data-faultid="{{fault.id}}" data-index="{{index}}" catch:tap="onRemoveFaultImage">×</view>
          </view>
          <view class="media-add" data-faultid="{{fault.id}}" bind:tap="onAddFaultImage">
            <text class="media-add-plus">+</text>
            <text class="media-add-text">加图</text>
          </view>
        </view>

        <view class="media-title">视频（0/1 或 1/1）</view>
        <view wx:if="{{fault.video}}" class="video-preview-wrap">
          <video
            class="video-preview"
            src="{{fault.video.url || fault.video.localPath}}"
            poster="{{fault.video.thumbnailUrl || ''}}"
            controls
            objectFit="cover"
          ></video>
          <view class="video-action-row">
            <view class="video-action-btn" data-faultid="{{fault.id}}" bind:tap="onAddFaultVideo">重选视频</view>
            <view class="video-action-btn video-action-btn-danger" data-faultid="{{fault.id}}" bind:tap="onRemoveFaultVideo">移除视频</view>
          </view>
        </view>
        <view wx:else class="media-add media-add-video" data-faultid="{{fault.id}}" bind:tap="onAddFaultVideo">
          <text class="media-add-plus">+</text>
          <text class="media-add-text">加视频</text>
        </view>
      </view>
    </view>
  </view>
  <view class="section-card" wx:else>
    <text class="section-title">故障详情填写</text>
    <view class="empty-tip">你还没有选择故障现象，本步骤可直接跳过进入下一步</view>
  </view>
</view>

<view class="flow-footer">
  <van-button plain round bind:tap="onPrev">上一步</van-button>
  <van-button type="primary" round bind:tap="onNext">下一步</van-button>
</view>
