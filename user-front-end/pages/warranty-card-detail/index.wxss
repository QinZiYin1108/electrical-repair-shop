.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef6ff 0%, #f6f8fc 30%, #f5f6f8 100%);
}

.hero-card,
.section-card {
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 55%, #8ddacb 100%);
  color: #fff;
}

.hero-status {
  font-size: 24rpx;
  opacity: 0.88;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #fff;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #eef2f7;
}

.info-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
}

.info-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 24rpx;
  color: #1f2937;
  line-height: 1.7;
  word-break: break-word;
}

.state-card {
  min-height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.state-text,
.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
  text-align: center;
}

.primary-btn {
  margin-top: 20rpx;
  width: 220rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn-disabled {
  opacity: 0.45;
}

.action-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.action-title,
.usage-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.action-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}

.usage-item {
  padding: 20rpx 0;
}

.usage-item + .usage-item {
  border-top: 1rpx solid #eef2f7;
}

.usage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.usage-status {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f766e;
}

.usage-time,
.usage-row,
.empty-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.7;
}

.usage-tip {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.7;
}
