---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    img: '/images/services/ac.webp',
    name: '空调维修',
    desc: '壁挂式、柜式、中央空调的安装、维修、加氟、清洗服务。常见故障：不制冷、漏水、异响、不启动、制冷效果差。',
    tags: ['热门']
  },
  {
    img: '/images/services/fridge.webp',
    name: '冰箱维修',
    desc: '家用冰箱、冰柜的不制冷、结冰、噪音大、门封老化、压缩机故障等维修服务，支持主流品牌全型号。',
    tags: []
  },
  {
    img: '/images/services/washer.webp',
    name: '洗衣机维修',
    desc: '波轮、滚筒洗衣机的进水故障、排水故障、不脱水、不转动、异响、漏水等维修，覆盖全品牌。',
    tags: []
  },
  {
    img: '/images/services/tv.webp',
    name: '电视维修',
    desc: '液晶电视、OLED 电视的黑屏、花屏、无信号、无法开机、屏幕闪烁等故障维修，支持各尺寸。',
    tags: []
  },
  {
    img: '/images/services/heater.webp',
    name: '热水器维修',
    desc: '电热水器、燃气热水器、太阳能热水器的不加热、漏水、打不着火、水温不稳等维修。',
    tags: []
  },
  {
    img: '/images/services/kitchen.webp',
    name: '厨房电器维修',
    desc: '油烟机、燃气灶、集成灶、微波炉、电饭煲、消毒柜等厨房电器的安装与维修服务。',
    tags: []
  },
  {
    img: null,
    name: '小家电维修',
    desc: '电风扇、取暖器、吸尘器、饮水机、空气净化器等生活小家电的故障维修。',
    tags: []
  },
  {
    img: null,
    name: '电路检修',
    desc: '家庭电路跳闸、开关插座更换、线路老化排查、配电箱维修等用电安全服务。',
    tags: []
  }
];
---

<BaseLayout
  title="服务项目"
  description="速修派提供空调、冰箱、洗衣机、电视、热水器等全品类家电维修服务，专业师傅上门，透明定价。"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <h1>服务项目</h1>
      <p>覆盖全品类家电，专业维修，一站解决</p>
    </div>
  </section>

  <!-- Service Cards -->
  <section class="section">
    <div class="container">
      <div class="services-detail-grid reveal-stagger">
        {
          services.map((s, i) => (
            <div class="service-detail-card">
              <div class="sd-illustration">
                {s.img ? (
                  <img
                    src={s.img}
                    alt={s.name}
                    width="120"
                    height="120"
                    loading="lazy"
                    class="sd-img"
                  />
                ) : (
                  <span class="sd-emoji">🔧</span>
                )}
              </div>
              <div class="sd-content">
                <div class="sd-header">
                  <h3>{s.name}</h3>
                  {s.tags.map((t) => (
                    <span class="sd-tag">{t}</span>
                  ))}
                </div>
                <p>{s.desc}</p>
                <a href="/contact" class="sd-link">
                  预约维修
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <>
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </>
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Not found CTA -->
  <section class="section" style="background:var(--color-bg-alt);">
    <div class="container" style="text-align:center;">
      <div class="section-header reveal">
        <h2 class="section-title">没找到需要的服务？</h2>
        <p class="section-subtitle">联系我们，客服将为您匹配最合适的维修方案</p>
      </div>
      <div class="reveal">
        <a href="/contact" class="btn btn-primary btn-lg">
          联系客服
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .services-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  /* ===== Card ===== */
  .service-detail-card {
    background: #fff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius);
    padding: 0;
    display: flex;
    overflow: hidden;
    transition:
      box-shadow 0.35s var(--ease-out-expo),
      border-color 0.35s,
      transform 0.35s;
  }
  .service-detail-card:hover {
    border-color: var(--glass-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  /* ===== Illustration ===== */
  .sd-illustration {
    width: 140px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-subtle);
    overflow: hidden;
  }

  .sd-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .service-detail-card:hover .sd-img {
    transform: scale(1.12);
  }

  .sd-emoji {
    font-size: 3rem;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .service-detail-card:hover .sd-emoji {
    transform: scale(1.15);
  }

  /* ===== Content ===== */
  .sd-content {
    padding: 28px;
    flex: 1;
  }

  .sd-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .sd-header h3 {
    font-size: 1.12rem;
    font-weight: 700;
  }

  .sd-tag {
    display: inline-block;
    background: var(--gradient-accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    letter-spacing: 0.03em;
  }

  .sd-content p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 16px;
  }

  .sd-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.92rem;
    transition: gap 0.3s;
  }
  .sd-link:hover {
    gap: 8px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .services-detail-grid {
      grid-template-columns: 1fr;
    }
    .service-detail-card {
      flex-direction: column;
    }
    .sd-illustration {
      width: 100%;
      height: 120px;
    }
  }
</style>
