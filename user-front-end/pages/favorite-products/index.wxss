.page {
  min-height: 100vh;
  padding: 0 24rpx 160rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top left, rgba(70, 155, 255, 0.14), transparent 34%),
    linear-gradient(180deg, #eef6ff 0%, #f6f8fc 32%, #f5f6f8 100%);
}

.hero-section {
  position: relative;
  margin: 0 -24rpx;
  padding: 28rpx 24rpx 0;
}

.hero-decoration {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-decoration-left {
  top: 26rpx;
  left: 18rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-decoration-right {
  top: 94rpx;
  right: 8rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(124, 214, 190, 0.14);
}

.hero-card,
.section-card,
.favorite-card {
  position: relative;
  z-index: 1;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 28rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 55%, #71d1b9 100%);
  color: #ffffff;
  overflow: hidden;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.88);
}

.hero-badge {
  flex-shrink: 0;
  min-width: 120rpx;
  padding: 14rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  text-align: center;
}

.hero-badge-count {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-badge-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-tips {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-tip-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
}

.section-card {
  margin-top: 22rpx;
  padding: 32rpx 24rpx;
  background: #ffffff;
}

.loading-card,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.state-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
  color: #64748b;
}

.state-btn {
  min-width: 240rpx;
  height: 84rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.favorite-list {
  margin-top: 20rpx;
}

.favorite-card {
  overflow: hidden;
  background: #ffffff;
}

.favorite-card + .favorite-card {
  margin-top: 20rpx;
}

.favorite-media {
  position: relative;
  height: 320rpx;
  background: linear-gradient(180deg, #eff6ff 0%, #f8fbff 100%);
}

.favorite-image,
.favorite-image-empty {
  width: 100%;
  height: 100%;
}

.favorite-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.badge-list {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.product-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
}

.badge-recommend {
  background: linear-gradient(135deg, #1677ff 0%, #36a6ff 100%);
}

.badge-hot {
  background: linear-gradient(135deg, #fb7185 0%, #f97316 100%);
}

.badge-new {
  background: linear-gradient(135deg, #22c55e 0%, #14b8a6 100%);
}

.favorite-body {
  padding: 22rpx 22rpx 24rpx;
}

.favorite-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.favorite-type,
.favorite-time {
  font-size: 22rpx;
}

.favorite-type {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #1677ff;
  background: #edf4ff;
}

.favorite-time {
  color: #64748b;
}

.favorite-name {
  display: block;
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #111827;
}

.favorite-meta,
.favorite-path {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.price-row {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.price-current {
  font-size: 34rpx;
  font-weight: 700;
  color: #ef4444;
}

.price-original {
  font-size: 22rpx;
  color: #94a3b8;
  text-decoration: line-through;
}

.flag-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.flag-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #475569;
  background: #f8fafc;
}

.action-row {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-link {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #1677ff;
}

.cancel-btn {
  min-width: 184rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff1f2;
  color: #e11d48;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn-disabled {
  opacity: 0.6;
}
