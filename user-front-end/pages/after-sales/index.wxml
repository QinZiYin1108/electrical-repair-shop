<view class="after-sales-page">
  <view wx:if="{{loading}}" class="state-card state-text">
    {{texts.loading}}
  </view>

  <view wx:elif="{{loadError}}" class="state-card">
    <view class="state-title">{{texts.loadFailed}}</view>
    <view class="state-desc">{{loadError}}</view>
    <view class="primary-btn retry-btn" bind:tap="onRetryTap">{{texts.retry}}</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="hero-card">
      <view class="hero-head">
        <view>
          <view class="hero-title">{{texts.title}}</view>
          <view class="hero-order">{{detail.orderNo}}</view>
        </view>
        <view class="hero-action" bind:tap="onViewOrderTap">{{texts.viewOrder}}</view>
      </view>
      <view class="hero-service">{{detail.serviceTitle}}</view>
      <view class="hero-status">{{detail.orderStatusText}}</view>
    </view>

    <view class="section-card">
      <view class="section-title">{{texts.applyTipTitle}}</view>
      <view class="info-row">
        <text class="info-label">{{texts.orderNoLabel}}</text>
        <text class="info-value">{{detail.orderNo || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.orderStatusLabel}}</text>
        <text class="info-value">{{detail.orderStatusText || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.serviceModeLabel}}</text>
        <text class="info-value">{{detail.serviceModeText || '-'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">{{texts.technicianLabel}}</text>
        <text class="info-value">{{detail.technicianName || '-'}}</text>
      </view>
      <view class="tip-block">{{detail.afterSalesTip || texts.applyTipFallback}}</view>
    </view>

    <view wx:if="{{detail.application}}" class="section-card">
      <view class="section-head">
        <view class="section-title">{{texts.historyTitle}}</view>
        <view class="status-badge">{{detail.application.statusText}}</view>
      </view>

      <view class="info-row">
        <text class="info-label">{{texts.reasonLabel}}</text>
        <text class="info-value">{{detail.application.reason || '-'}}</text>
      </view>
      <view wx:if="{{detail.application.description}}" class="info-row">
        <text class="info-label">{{texts.descLabel}}</text>
        <text class="info-value">{{detail.application.description}}</text>
      </view>
      <view wx:if="{{detail.application.createdTimeText}}" class="info-row">
        <text class="info-label">{{texts.createdLabel}}</text>
        <text class="info-value">{{detail.application.createdTimeText}}</text>
      </view>
      <view wx:if="{{detail.application.processedTimeText}}" class="info-row">
        <text class="info-label">{{texts.processedLabel}}</text>
        <text class="info-value">{{detail.application.processedTimeText}}</text>
      </view>
      <view wx:if="{{detail.application.completedTimeText}}" class="info-row">
        <text class="info-label">{{texts.completedLabel}}</text>
        <text class="info-value">{{detail.application.completedTimeText}}</text>
      </view>
      <view wx:if="{{detail.application.adminRemark}}" class="info-row">
        <text class="info-label">{{texts.adminRemarkLabel}}</text>
        <text class="info-value">{{detail.application.adminRemark}}</text>
      </view>
      <view wx:if="{{detail.application.refundAmount !== '0.00'}}" class="info-row">
        <text class="info-label">{{texts.refundAmountLabel}}</text>
        <text class="info-value">￥{{detail.application.refundAmount}}</text>
      </view>

      <view class="media-block">
        <view class="media-title">{{texts.imageTitle}}</view>
        <view wx:if="{{detail.application.evidenceImages.length}}" class="image-grid">
          <image
            wx:for="{{detail.application.evidenceImages}}"
            wx:key="id"
            class="image-item"
            src="{{item.thumbnailUrl}}"
            mode="aspectFill"
            data-current="{{item.url}}"
            bind:tap="onPreviewEvidenceImage"
          />
        </view>
        <view wx:else class="media-empty">{{texts.mediaEmpty}}</view>
      </view>

      <view class="media-block">
        <view class="media-title">{{texts.videoTitle}}</view>
        <block wx:if="{{detail.application.evidenceVideos.length}}">
          <view wx:for="{{detail.application.evidenceVideos}}" wx:key="id" class="video-card">
            <video class="video-player" src="{{item.url}}" poster="{{item.thumbnailUrl}}" controls objectFit="cover" />
            <view wx:if="{{item.durationText}}" class="video-meta">{{item.durationText}}</view>
          </view>
        </block>
        <view wx:else class="media-empty">{{texts.mediaEmpty}}</view>
      </view>

      <view wx:if="{{detail.application.canCancel}}" class="ghost-btn" bind:tap="onCancelAfterSalesTap">
        {{submitting ? texts.submitting : texts.cancelAction}}
      </view>
    </view>

    <view wx:if="{{detail.canApplyAfterSales}}" class="section-card form-card">
      <view class="section-title">{{texts.formTitle}}</view>

      <view class="field-title">{{texts.reasonTitle}}</view>
      <view class="chip-list">
        <view
          wx:for="{{reasonOptions}}"
          wx:key="*this"
          class="chip {{selectedReason === item ? 'chip-active' : ''}}"
          data-reason="{{item}}"
          bind:tap="onChooseReason"
        >
          {{item}}
        </view>
      </view>

      <view class="field-title">{{texts.descTitle}}</view>
      <textarea
        class="desc-textarea"
        value="{{description}}"
        placeholder="{{texts.descPlaceholder}}"
        maxlength="300"
        auto-height
        bindinput="onDescriptionInput"
      />

      <view class="field-title">{{texts.imageTitle}}</view>
      <view class="field-tip">{{texts.imageTip}}</view>
      <view class="image-grid upload-grid">
        <view wx:for="{{uploadImages}}" wx:key="id" class="upload-image-wrap">
          <image
            class="image-item"
            src="{{item.thumbnailUrl}}"
            mode="aspectFill"
            data-current="{{item.url}}"
            bind:tap="onPreviewUploadImage"
          />
          <view class="delete-tag" data-index="{{index}}" catch:tap="onDeleteImage">x</view>
        </view>
        <view wx:if="{{uploadImages.length < 5}}" class="upload-trigger" bind:tap="onChooseImages">
          <view class="upload-trigger-plus">+</view>
          <view class="upload-trigger-text">{{texts.addImage}}</view>
        </view>
      </view>

      <view class="field-title">{{texts.videoTitle}}</view>
      <view class="field-tip">{{texts.videoTip}}</view>
      <view wx:if="{{uploadVideo}}" class="video-card upload-video-wrap">
        <video class="video-player" src="{{uploadVideo.url}}" poster="{{uploadVideo.thumbnailUrl}}" controls objectFit="cover" />
        <view class="delete-tag" catch:tap="onDeleteVideo">x</view>
      </view>
      <view wx:else class="upload-trigger video-trigger" bind:tap="onChooseVideo">
        <view class="upload-trigger-plus">+</view>
        <view class="upload-trigger-text">{{texts.addVideo}}</view>
      </view>

      <view class="primary-btn submit-btn" bind:tap="onSubmitTap">
        {{submitting ? texts.submitting : texts.submit}}
      </view>
    </view>

    <view wx:if="{{!detail.application && !detail.canApplyAfterSales}}" class="section-card empty-card">
      <view class="empty-text">{{texts.noData}}</view>
      <view class="tip-block">{{detail.afterSalesTip || texts.applyTipFallback}}</view>
    </view>
  </block>
</view>
