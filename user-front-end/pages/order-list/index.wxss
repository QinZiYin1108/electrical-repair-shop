.order-list-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f8ff 0%, #f7f9fc 40%, #f5f6f8 100%);
}

.tab-scroll {
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  padding-right: 20rpx;
}

.tab-item {
  margin-right: 16rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background-color: #ffffff;
  color: #516072;
  font-size: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(17, 24, 39, 0.05);
}

.tab-item-active {
  background: linear-gradient(135deg, #1677ff 0%, #36cfc9 100%);
  color: #ffffff;
}

.state-card,
.order-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.06);
}

.state-card {
  margin-top: 20rpx;
  text-align: center;
}

.state-text {
  color: #667085;
  font-size: 26rpx;
}

.state-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 196rpx;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.order-card + .order-card {
  margin-top: 20rpx;
}

.order-head,
.order-foot,
.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-head {
  gap: 20rpx;
}

.order-no {
  flex: 1;
  min-width: 0;
  color: #64748b;
  font-size: 24rpx;
}

.order-status {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background-color: #edf4ff;
  color: #1677ff;
  font-size: 22rpx;
  font-weight: 500;
}

.order-title {
  margin-top: 18rpx;
  color: #132238;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.order-appliance {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.meta-row {
  margin-top: 16rpx;
  gap: 20rpx;
}

.meta-label {
  flex-shrink: 0;
  width: 132rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.meta-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  text-align: right;
  line-height: 1.5;
  word-break: break-all;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.order-foot-main {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.order-foot-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.order-amount {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.order-payment {
  color: #1677ff;
  font-size: 22rpx;
  background-color: #edf4ff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.door-qr-btn {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.confirm-btn,
.cancel-btn,
.after-sales-btn,
.pay-btn {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}

.confirm-btn {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 10rpx 22rpx rgba(20, 184, 166, 0.16);
}

.cancel-btn {
  background: linear-gradient(135deg, #f97316 0%, #ef4444 100%);
  box-shadow: 0 10rpx 22rpx rgba(239, 68, 68, 0.16);
}

.after-sales-btn {
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
  box-shadow: 0 10rpx 22rpx rgba(37, 99, 235, 0.16);
}

.pay-btn {
  background: linear-gradient(135deg, #ff8a3d 0%, #ff5b5b 100%);
  box-shadow: 0 10rpx 22rpx rgba(255, 91, 91, 0.18);
}

.door-qr-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background-color: rgba(15, 23, 42, 0.52);
}

.door-qr-popup {
  width: 100%;
  max-width: 620rpx;
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  text-align: center;
}

.door-qr-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 600;
}

.door-qr-order,
.door-qr-expire,
.door-qr-loading,
.door-qr-status {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.door-qr-image {
  width: 420rpx;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
}

.door-qr-status {
  color: #1677ff;
  font-weight: 500;
}

.door-qr-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
  color: #ffffff;
  font-size: 24rpx;
}
