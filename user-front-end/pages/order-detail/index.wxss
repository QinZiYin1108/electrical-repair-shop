.order-detail-page {
  min-height: 100vh;
  padding: 20rpx 24rpx 180rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f4f8ff 0%, #f7f9fc 38%, #f5f6f8 100%);
}

.state-card,
.hero-card,
.section-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(17, 24, 39, 0.06);
}

.state-card {
  padding: 28rpx 24rpx;
  text-align: center;
}

.state-text {
  color: #667085;
  font-size: 26rpx;
}

.state-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 12rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.6;
}

.action-btn,
.copy-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
}

.action-btn {
  min-width: 196rpx;
  margin-top: 24rpx;
  padding: 18rpx 28rpx;
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
}

.hero-card {
  padding: 28rpx 26rpx;
  background: linear-gradient(135deg, #1f6dff 0%, #2bc0c8 100%);
  color: #ffffff;
}

.hero-head,
.progress-head,
.info-row,
.fault-row,
.pay-fee-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-head {
  align-items: center;
}

.hero-status {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
}

.copy-link {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
}

.hero-no {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
  word-break: break-all;
}

.section-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.section-toggle {
  flex-shrink: 0;
  color: #64748b;
  font-size: 22rpx;
}

.section-content {
  margin-top: 18rpx;
}

.info-row + .info-row,
.fault-row + .fault-row,
.pay-fee-row + .pay-fee-row {
  margin-top: 18rpx;
}

.info-label,
.fault-label,
.pay-fee-label {
  flex-shrink: 0;
  width: 152rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.info-value,
.fault-value,
.pay-fee-value {
  flex: 1;
  min-width: 0;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.6;
  text-align: right;
  word-break: break-all;
}

.info-value-strong,
.pay-fee-value-strong {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
}

.fault-card {
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background-color: #f8fbff;
}

.fault-card + .fault-card {
  margin-top: 18rpx;
}

.media-section {
  margin-top: 18rpx;
}

.media-title {
  color: #64748b;
  font-size: 22rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.fault-image {
  width: 170rpx;
  height: 170rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background-color: #e5e7eb;
}

.video-item + .video-item {
  margin-top: 16rpx;
}

.fault-video {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
  border-radius: 18rpx;
  background-color: #0f172a;
}

.video-duration {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.progress-item {
  position: relative;
  padding-left: 28rpx;
}

.progress-item + .progress-item {
  margin-top: 20rpx;
}

.progress-item::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  bottom: -22rpx;
  width: 2rpx;
  background-color: #dbeafe;
}

.progress-item:last-child::before {
  display: none;
}

.progress-dot {
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1677ff 0%, #36cfc9 100%);
  box-shadow: 0 0 0 8rpx rgba(22, 119, 255, 0.1);
}

.progress-main {
  padding-left: 10rpx;
}

.progress-status {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}

.progress-time {
  flex-shrink: 0;
  color: #94a3b8;
  font-size: 22rpx;
}

.progress-desc,
.progress-operator,
.empty-text {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-desc {
  white-space: pre-wrap;
  word-break: break-word;
}

.float-action-group {
  position: fixed;
  right: 28rpx;
  bottom: 44rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.door-qr-float-btn,
.confirm-float-btn,
.cancel-float-btn,
.review-float-btn,
.after-sales-float-btn,
.pay-float-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 28rpx rgba(22, 119, 255, 0.24);
}

.door-qr-float-btn {
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
}

.confirm-float-btn {
  background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  box-shadow: 0 12rpx 28rpx rgba(20, 184, 166, 0.24);
}

.cancel-float-btn {
  background: linear-gradient(135deg, #f97316 0%, #ef4444 100%);
  box-shadow: 0 12rpx 28rpx rgba(239, 68, 68, 0.24);
}

.after-sales-float-btn {
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
  box-shadow: 0 12rpx 28rpx rgba(37, 99, 235, 0.24);
}

.review-float-btn {
  background: linear-gradient(135deg, #0f766e 0%, #16a34a 100%);
  box-shadow: 0 12rpx 28rpx rgba(22, 163, 74, 0.24);
}

.pay-float-btn {
  background: linear-gradient(135deg, #ff8a3d 0%, #ff5b5b 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 91, 91, 0.24);
}

.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background-color: rgba(15, 23, 42, 0.52);
}

.door-qr-popup,
.pay-popup {
  width: 100%;
  max-width: 640rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-sizing: border-box;
}

.door-qr-popup {
  padding: 30rpx 28rpx;
  text-align: center;
}

.pay-popup {
  max-height: 84vh;
  padding: 30rpx 28rpx 32rpx;
  overflow-y: auto;
}

.action-popup {
  width: 100%;
  max-width: 640rpx;
  max-height: 84vh;
  padding: 30rpx 28rpx 32rpx;
  border-radius: 28rpx;
  background-color: #ffffff;
  box-sizing: border-box;
  overflow-y: auto;
}

.door-qr-title,
.pay-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 600;
}

.door-qr-order,
.door-qr-expire,
.door-qr-loading,
.door-qr-status,
.pay-order-no,
.pay-subtitle {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.door-qr-image {
  width: 420rpx;
  height: 420rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
}

.door-qr-status {
  color: #1677ff;
  font-weight: 500;
}

.door-qr-close,
.pay-confirm-btn,
.pay-cancel-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 200rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.door-qr-close {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #1677ff 0%, #2dd4bf 100%);
  color: #ffffff;
}

.pay-subtitle {
  margin-top: 10rpx;
}

.pay-section {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #f8fbff 0%, #f6f9fc 100%);
}

.pay-section-title,
.pay-method-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-section-desc {
  margin-top: 10rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.7;
}

.pay-fee-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background-color: #fbfcff;
  border: 1rpx solid #e6eefb;
}

.pay-method-title {
  margin-top: 24rpx;
}

.reason-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.reason-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background-color: #f8fafc;
  border: 2rpx solid #e2e8f0;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.4;
}

.reason-chip-active {
  border-color: #f97316;
  background-color: #fff7ed;
  color: #c2410c;
}

.action-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background-color: #f8fafc;
  border: 2rpx solid #e2e8f0;
  box-sizing: border-box;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.7;
}

.pay-method-list {
  margin-top: 16rpx;
}

.pay-method-item {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e5edf7;
  background-color: #ffffff;
}

.pay-method-item + .pay-method-item {
  margin-top: 16rpx;
}

.pay-method-item-active {
  border-color: #ff8a3d;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 61, 0.12);
}

.pay-method-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.pay-method-label {
  color: #0f172a;
  font-size: 26rpx;
  font-weight: 600;
}

.pay-method-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  box-sizing: border-box;
  background-color: #ffffff;
}

.pay-method-indicator-active {
  border-color: #ff6b4a;
}

.pay-method-indicator-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a3d 0%, #ff5b5b 100%);
}

.pay-method-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.6;
}

.pay-warning {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background-color: #fff7ed;
  color: #ea580c;
  font-size: 22rpx;
  line-height: 1.6;
}

.pay-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pay-cancel-btn,
.pay-confirm-btn {
  flex: 1;
}

.pay-cancel-btn {
  background-color: #eef2f7;
  color: #475569;
}

.pay-confirm-btn {
  background: linear-gradient(135deg, #ff8a3d 0%, #ff5b5b 100%);
  color: #ffffff;
}
